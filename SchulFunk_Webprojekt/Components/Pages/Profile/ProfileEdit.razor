@page "/profile/edit"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@inject NavigationManager NavigationManager

<PageTitle>Profil bearbeiten</PageTitle>

<section class="profile-edit-layout">
    <div class="profile-edit-form sf-panel">
        <div class="form-group">
            <label for="profile-name">Name</label>
            <input id="profile-name" type="text" class="form-control" @bind="UserName" @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label for="profile-email">E-Mail-Adresse</label>
            <input id="profile-email" type="email" class="form-control" @bind="UserEmail" @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label for="profile-password">Passwort</label>
            <input id="profile-password" type="password" class="form-control" @bind="UserPassword" @bind:event="oninput" />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Klasse</label>
                <div class="readonly-info-box">
                    <strong>@UserClass</strong>
                </div>
            </div>

            <div class="form-group">
                <label>Rolle</label>
                <div class="readonly-info-box">
                    <strong>@UserRole</strong>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="sf-button sf-button-dark" @onclick="SaveProfile">
                Speichern
            </button>

            <button type="button" class="sf-button" @onclick="CancelEdit">
                Abbrechen
            </button>
        </div>
    </div>
</section>

@code {
    private UserModel CurrentUser => TestLoginData.CurrentUser;

    private string UserName = "";
    private string UserEmail = "";
    private string UserPassword = "12345678";
    private string UserClass = "";
    private string UserRole = "";

    protected override void OnInitialized()
    {
        UserName = $"{CurrentUser.Name} {CurrentUser.Lastname}".Trim();
        UserEmail = CurrentUser.Email;
        UserClass = CurrentUser.Class.ClassName;
        UserRole = PermissionRules.GetGroupLabel(CurrentUser.Group);
    }

    private void SaveProfile()
    {
        NavigationManager.NavigateTo("/profile");
    }

    private void CancelEdit()
    {
        NavigationManager.NavigateTo("/profile");
    }
}