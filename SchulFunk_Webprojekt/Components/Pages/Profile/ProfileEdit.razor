@page "/profile/edit"
@rendermode InteractiveServer

<PageTitle>Profil bearbeiten</PageTitle>

<section class="profile-edit-header sf-panel">
    <div class="profile-edit-title">
        <img src="/lib/images/Icon-User.png" alt="Profil Icon" />

        <div>
            <h2>Profil bearbeiten</h2>
            <p>Hier kannst du deine persönlichen Zugangsdaten ändern.</p>
        </div>
    </div>
</section>

<section class="profile-edit-layout">
    <div class="profile-edit-form sf-panel">

        <div class="form-group">
            <label for="profile-name">Name</label>
            <input id="profile-name"
                   type="text"
                   class="form-control"
                   @bind="UserName"
                   @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label for="profile-email">E-Mail-Adresse</label>
            <input id="profile-email"
                   type="email"
                   class="form-control"
                   @bind="UserEmail"
                   @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label for="profile-password">Passwort</label>
            <input id="profile-password"
                   type="password"
                   class="form-control"
                   @bind="UserPassword"
                   @bind:event="oninput" />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Klasse</label>

                <div class="readonly-info-box">
                    <strong>@UserClass</strong>
                </div>
            </div>

            <div class="form-group">
                <label>Rolle</label>

                <div class="readonly-info-box">
                    <strong>@UserRole</strong>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="button"
                    class="sf-button sf-button-dark"
                    @onclick="SaveProfile">
                Speichern
            </button>

            <button type="button"
                    class="sf-button"
                    @onclick="CancelEdit">
                Abbrechen
            </button>
        </div>
    </div>
</section>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    // Testdaten fürs Frontend.
    // Später kommen diese Werte aus dem Login/Auth-System.
    private string UserName = "Max Mustermann";
    private string UserEmail = "max.mustermann@schule.de";
    private string UserPassword = "12345678";

    private string UserClass = "10A";
    private string UserRole = "Klassensprecher";

    private void SaveProfile()
    {
        // Später kommt hier die echte Speicherlogik hin.
        NavigationManager.NavigateTo("/profile");
    }

    private void CancelEdit()
    {
        // Änderungen werden verworfen, weil aktuell nichts gespeichert wird.
        NavigationManager.NavigateTo("/profile");
    }
}