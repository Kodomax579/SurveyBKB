@page "/profile/edit"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@inject UserStateService userStateService
@inject UserService userService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Profil bearbeiten</PageTitle>

<section class="profile-edit-layout">
    <div class="profile-edit-form sf-panel">
        <div class="form-group">
            <label for="profile-name">Name</label>
            <input id="profile-name" type="text" class="form-control" @bind="CurrentUser.Lastname" @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label for="profile-name">Vorname</label>
            <input id="profile-name" type="text" class="form-control" @bind="CurrentUser.Firstname" @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label for="profile-email">E-Mail-Adresse</label>
            <input id="profile-email" type="email" class="form-control" @bind="CurrentUser.Email" @bind:event="oninput" />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Klasse</label>
                <div class="readonly-info-box">
                    <strong>@CurrentUser.Class.Classname</strong>
                </div>
            </div>

            <div class="form-group">
                <label>Rolle</label>
                <div class="readonly-info-box">
                    <strong>@UserRole</strong>
                </div>
            </div>
        </div>

        <div>

            <button @onclick="OpenPasswordModal">
                Change Password
            </button>
            @if(!string.IsNullOrEmpty(ErrorMessage))
            {
                <p>@ErrorMessage</p>
            }
        </div>

        <div class="form-actions">
            <button type="button" class="sf-button sf-button-dark" @onclick="SaveProfile">
                Speichern
            </button>

            <button type="button" class="sf-button" @onclick="CancelEdit">
                Abbrechen
            </button>
        </div>
    </div>
</section>
<ChangePasswordModal IsVisible="ShowPasswordModal"
                     OnClose="ClosePasswordModal"
                     OnPasswordChanged="HandlePasswordChange" />

@code {
    private UserModel CurrentUser => userStateService.GetUser();
    private bool ShowPasswordModal = false;
    private string ErrorMessage = string.Empty;
    private string UserRole =>
        PermissionRules.GetGroupLabel(CurrentUser.Group);

    protected override void OnInitialized()
    {
        userStateService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    private void OpenPasswordModal()
    {
        ShowPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        ShowPasswordModal = false;
    }

    private async Task HandlePasswordChange((string oldPw, string newPw) data)
    {
        var (oldPw, newPw) = data;

        // Beispiel: Service aufrufen
        var result = await userService.ChangePassword(CurrentUser.Id, oldPw, newPw);

        ShowPasswordModal = false;

        if(!result)
        {
            ErrorMessage = "Neues Passwort wurde nicht gesetzt (Falsches passwort eingegeben)";
            StateHasChanged();
        }
        else
        {
            ErrorMessage = string.Empty;
        }
    }


    private void SaveProfile()
    {
        userService.UpdateUser(CurrentUser.Id, CurrentUser);
        NavigationManager.NavigateTo("/profile");
    }

    private void CancelEdit()
    {
        NavigationManager.NavigateTo("/profile");
    }

    public void Dispose()
    {
        userStateService.OnChange -= HandleStateChanged;
    }
}