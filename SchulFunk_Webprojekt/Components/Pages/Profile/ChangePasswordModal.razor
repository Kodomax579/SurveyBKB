@if (IsVisible)
{
    <div class="modal-backdrop">
        <div class="modal-container sf-panel">
            <h3>Passwort ändern</h3>

            <div class="form-group">
                <label>Altes Passwort</label>
                <input type="password" class="form-control" @bind="OldPassword" />
            </div>

            <div class="form-group">
                <label>Neues Passwort</label>
                <input type="password" class="form-control" @bind="NewPassword" />
            </div>

            <div class="form-group">
                <label>Neues Passwort bestätigen</label>
                <input type="password" class="form-control" @bind="ConfirmPassword" />
            </div>

            <div class="form-actions">
                <button class="sf-button sf-button-dark" @onclick="Submit">Speichern</button>
                <button class="sf-button" @onclick="Close">Abbrechen</button>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="text-danger">@ErrorMessage</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(string oldPw, string newPw)> OnPasswordChanged { get; set; }

    private string OldPassword;
    private string NewPassword;
    private string ConfirmPassword;
    private string ErrorMessage;

    private async Task Submit()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(NewPassword) || NewPassword.Length < 8)
        {
            ErrorMessage = "Passwort muss mindestens 8 Zeichen lang sein.";
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            ErrorMessage = "Passwörter stimmen nicht überein.";
            return;
        }

        await OnPasswordChanged.InvokeAsync((OldPassword, NewPassword));
        await Close();
    }

    private async Task Close()
    {
        OldPassword = "";
        NewPassword = "";
        ConfirmPassword = "";
        ErrorMessage = null;

        await OnClose.InvokeAsync();
    }
}