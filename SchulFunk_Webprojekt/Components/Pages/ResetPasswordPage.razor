@page "/reset-password"
@inject UserService userService
@inject NavigationManager NavManager
@layout EmptyLayout

<PageTitle>Passwort zurücksetzen - SchulFunk</PageTitle>

<div class="auth-wrapper">
    <div class="sf-panel auth-panel">
        <div class="auth-header">
            <img src="/lib/images/SchulFunk-Logo.png" alt="SchulFunk Logo" class="auth-logo" />
            <h2>Passwort <span>zurücksetzen</span></h2>
            <p>Gib dein neues Passwort für die Adresse <strong>@Email</strong> ein.</p>
        </div>

        @if (isSuccess)
        {
            <div class="success-message">
                Dein Passwort wurde erfolgreich geändert!
                <br />Du wirst in wenigen Sekunden zum Login weitergeleitet...
            </div>
        }
        else
        {
            <div class="auth-form">
                <div class="form-group">
                    <label>Neues Passwort</label>
                    <input type="password" class="sf-input" placeholder="••••••••" @bind-value="newPassword" />
                </div>

                <div class="form-group">
                    <label>Passwort bestätigen</label>
                    <input type="password" class="sf-input" placeholder="••••••••" @bind-value="confirmPassword" />
                </div>

                @if (!string.IsNullOrWhiteSpace(Fehlermeldung))
                {
                    <div class="validation-message">
                        @Fehlermeldung
                    </div>
                }

                <button class="sf-button w-100 mt-2" @onclick="PasswortSpeichern" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span>Wird gespeichert...</span>
                    }
                    else
                    {
                        <span>Passwort speichern</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

@code {
    // Holt sich die E-Mail automatisch aus der URL (?email=test@test.de)
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private string? newPassword;
    private string? confirmPassword;
    private string Fehlermeldung = "";
    private bool isProcessing = false;
    private bool isSuccess = false;

    protected override void OnInitialized()
    {
        // Falls jemand die Seite ohne E-Mail aufruft, zurück zum Login schicken
        if (string.IsNullOrWhiteSpace(Email))
        {
            NavManager.NavigateTo("/");
        }
    }

    private async Task PasswortSpeichern()
    {
        Fehlermeldung = "";

        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            Fehlermeldung = "Bitte fülle beide Passwortfelder aus.";
            return;
        }

        if (newPassword.Length < 6) // Optionale Sicherheitsprüfung
        {
            Fehlermeldung = "Das Passwort muss mindestens 6 Zeichen lang sein.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            Fehlermeldung = "Die Passwörter stimmen nicht überein.";
            return;
        }

        isProcessing = true;
        try
        {
            // Übergabe an deinen UserService im Frontend
            var erfolg = await userService.ResetPassword(Email!, newPassword);

            if (erfolg)
            {
                isSuccess = true;
                StateHasChanged();

                // 3 Sekunden warten, dann zum Login umleiten
                await Task.Delay(3000);
                NavManager.NavigateTo("/");
            }
            else
            {
                Fehlermeldung = "Fehler beim Zurücksetzen des Passworts. Der Link ist möglicherweise abgelaufen.";
            }
        }
        catch (Exception)
        {
            Fehlermeldung = "Es konnte keine Verbindung zum Server hergestellt werden.";
        }
        finally
        {
            isProcessing = false;
        }
    }
}