@using SchulFunk_Webprojekt.Model
@using SchulFunk_Webprojekt.Components.Pages.Survey
@inject SurveyStateService surveyStateService
@inject UserStateService userStateService
@implements IDisposable

<aside class="sf-sidebar sf-sidebar-right">
    <h3 class="sf-sidebar-heading">Aktuelle Umfragen</h3>

    <div class="sf-sidebar-surveys">
        @if (SurveyListe.Any())
        {
            @foreach (var survey in SurveyListe)
            {
                <SurveyCard Item="@survey" />
            }
        }
        else
        {
            <div class="card sf-sticky-box">
                <div class="card-content">
                    <p class="preview-text">Du hast alle Umfragen beantwortet. Es gibt derzeit keine neuen Umfragen für dich.</p>
                </div>
            </div>
        }
    </div>
</aside>

@code {
    private List<SurveyModel> SurveyListe
    {
        get
        {
            var currentUser = userStateService.GetUser();
            var userClass = currentUser?.Class?.Classname;
            var currentUserId = currentUser?.Id;
            var isTeacher = currentUser?.Class?.Classname == "Lehrer";

            var today = DateOnly.FromDateTime(DateTime.Today);

            return surveyStateService.GetAllSurveys()
                .Where(s =>
                    s.OnlineUntil >= today

    &&

                    !(currentUserId.HasValue && s.UserIDs != null && s.UserIDs.Contains(currentUserId.Value))

    &&

                    (
                        isTeacher ||
                        s.Classes == null ||
                        s.Classes.Count == 0 ||
                        (!string.IsNullOrWhiteSpace(userClass) && s.Classes.Contains(userClass))
                    )
                )
                .Take(3)
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        surveyStateService.OnChange += UpdateUI;
    }

    private void UpdateUI() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        surveyStateService.OnChange -= UpdateUI;
    }
}