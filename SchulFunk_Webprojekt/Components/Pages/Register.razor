@page "/admin/register"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Feature.UserHandling.Model
@using SchulFunk_Webprojekt.Model
@inject NavigationManager NavManager
@inject UserService userService
@inject UserStateService userStateService

<PageTitle>Benutzer registrieren - SchulFunk</PageTitle>

@if (!CanRegisterUsers)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine neuen Benutzer registrieren.</p>
    </section>
}
else
{
    <section class="register-layout">
        <div class="sf-panel register-panel">
            <div class="register-header">
                <img src="/lib/images/Icon-User.png" alt="Benutzer Icon" />
                <div>
                    <h2>Benutzer registrieren</h2>
                    <p>Lege hier neue Benutzer für SchulFunk an.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Erfolgsmeldung))
            {
                <div class="register-success">
                    @Erfolgsmeldung
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Fehlermeldung))
            {
                <div class="register-error">
                    @Fehlermeldung
                </div>
            }

            <div class="auth-form">
                <div class="row-group">
                    <div class="form-group half-width">
                        <label>Vorname</label>
                        <input type="text"
                               class="sf-input"
                               placeholder="Max"
                               @bind="newUser.Firstname"
                               @bind:event="oninput" />
                    </div>

                    <div class="form-group half-width">
                        <label>Nachname</label>
                        <input type="text"
                               class="sf-input"
                               placeholder="Mustermann"
                               @bind="newUser.Lastname"
                               @bind:event="oninput" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Benutzerrolle</label>
                    <select class="sf-input" @bind="newUser.Group">
                        @foreach (var group in RegisterableGroups)
                        {
                            <option value="@group">@PermissionRules.GetGroupLabel(group)</option>
                        }
                    </select>
                </div>

                @if (newUser.Group == Groups.Teacher)
                {
                    <div class="form-group">
                        <label>Klasse / Bereich</label>
                        <div class="readonly-info-box">
                            <strong>Lehrer</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Klasse</label>
                        <select class="sf-input" @bind="newUser.Class!.ClassName">
                            @foreach (var klasse in AvailableClasses)
                            {
                                <option value="@klasse.ClassName">@klasse.ClassName</option>
                            }
                        </select>
                    </div>
                }

                <div class="form-group">
                    <label>E-Mail Adresse</label>
                    <input type="email"
                           class="sf-input"
                           placeholder="max.mustermann@schule.de"
                           @bind="newUser.Email"
                           @bind:event="oninput" />
                </div>

                <div class="form-actions">
                    <button class="sf-button sf-button-dark" @onclick="Registrieren">
                        Benutzer registrieren
                    </button>

                    <a href="/admin" class="sf-button">
                        Zurück zum Admin Panel
                    </a>
                </div>
            </div>
        </div>
    </section>
}

@code {
    // TODO: Ersetze dies durch deinen echten angemeldeten Benutzer (z.B. über AuthenticationState)
    private UserModel CurrentUser => userStateService.GetUser();

    // Unser direktes Bindungs-Modell (Class muss initialisiert werden, damit es bei der Klassenauswahl nicht kracht)
    private UserModel newUser = new UserModel { Class = new ClassModel() };

    private List<ClassModel> AvailableClasses = new();
    private string Erfolgsmeldung = "";
    private string Fehlermeldung = "";

    private bool CanRegisterUsers =>
        PermissionRules.HasPermission(CurrentUser, Permission.RegisterStudentUsers) ||
        PermissionRules.HasPermission(CurrentUser, Permission.RegisterTeacherUsers);

    private List<Groups> RegisterableGroups
    {
        get
        {
            var groups = new List<Groups>();

            if (PermissionRules.HasPermission(CurrentUser, Permission.RegisterStudentUsers))
            {
                groups.Add(Groups.Student);
            }

            if (PermissionRules.HasPermission(CurrentUser, Permission.RegisterTeacherUsers))
            {
                groups.Add(Groups.Teacher);
            }

            return groups;
        }
    }

    protected async override Task OnInitializedAsync()
    {
        AvailableClasses = await userService.GetAllClasses();

        // Standardwerte setzen, wenn Daten geladen wurden
        if (RegisterableGroups.Any())
        {
            newUser.Group = RegisterableGroups.First();
        }

        if (AvailableClasses.Any())
        {
            newUser.Class!.ClassName = AvailableClasses.First().ClassName;
        }
    }

    private async Task Registrieren()
    {
        Erfolgsmeldung = "";
        Fehlermeldung = "";

        if (!CanRegisterUsers)
        {
            Fehlermeldung = "Du hast keine Berechtigung, Benutzer zu registrieren.";
            return;
        }

        if (!RegisterableGroups.Contains(newUser.Group))
        {
            Fehlermeldung = "Du darfst diese Benutzerrolle nicht registrieren.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newUser.Firstname) ||
            string.IsNullOrWhiteSpace(newUser.Lastname) ||
            string.IsNullOrWhiteSpace(newUser.Email))
        {
            Fehlermeldung = "Bitte fülle alle Pflichtfelder aus.";
            return;
        }

        // Leerzeichen entfernen
        newUser.Firstname = newUser.Firstname.Trim();
        newUser.Lastname = newUser.Lastname.Trim();
        newUser.Email = newUser.Email.Trim();

        // Lehrer bekommen eine feste Klasse zugeordnet
        if (newUser.Group == Groups.Teacher)
        {
            newUser.Class = new ClassModel { ClassName = "Lehrer" };
        }

        // Wir rufen den Service jetzt direkt mit dem UserModel auf
        var success = await userService.CreateUser(newUser);

        if (success)
        {
            Erfolgsmeldung = $"Benutzer {newUser.Firstname} {newUser.Lastname} erfolgreich angelegt (Standardpasswort gesetzt).";

            // Formular zurücksetzen
            newUser = new UserModel { Class = new ClassModel() };

            if (RegisterableGroups.Any())
            {
                newUser.Group = RegisterableGroups.First();
            }

            if (AvailableClasses.Any())
            {
                newUser.Class.ClassName = AvailableClasses.First().ClassName;
            }
        }
        else
        {
            Fehlermeldung = "Die Registrierung ist fehlgeschlagen. Möglicherweise existiert die E-Mail bereits.";
        }
    }
}