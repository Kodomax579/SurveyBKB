@page "/survey/{SurveyId:int}"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@inject UserStateService userStateService
@inject SurveyStateService surveyStateService
@inject SchulFunk_Webprojekt.Feature.SurveyHandling.SurveyService surveyService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable

<PageTitle>@(Survey?.Title ?? "Umfrage")</PageTitle>

@if (Survey is null)
{
    <section class="survey-detail-page sf-panel">
        <h2>Umfrage nicht gefunden</h2>
        <p>Die gewünschte Umfrage konnte nicht gefunden werden.</p>
        <a href="/survey" class="sf-button sf-button-dark">Zurück zu den Umfragen</a>
    </section>
}
else
{
    <section class="survey-detail-page sf-panel">
        <div class="survey-detail-header">
            <img src="/lib/images/Icon-Survey.png" alt="Umfrage Icon" />

            <div>
                <span>@GetSurveyStatusText()</span>
                <h2>@Survey.Title</h2>
                <p>
                    Erstellt von @Survey.CreatorName ·
                    Erstellt am @Survey.CreatedAt.ToString("dd.MM.yyyy") ·
                    @(IsExpired ? "Abgelaufen am" : "Läuft bis") @Survey.OnlineUntil.ToString("dd.MM.yyyy")
                </p>
            </div>
        </div>

        @if (IsExpired)
        {
            <div class="survey-expired-notice">
                <strong>Diese Umfrage ist abgelaufen.</strong>
                <p>
                    Es können keine neuen Antworten mehr abgegeben werden, damit die Ergebnisse nicht nachträglich beeinflusst werden.
                </p>
            </div>
        }

        @if (!PermissionRules.HasPermission(CurrentUser, Permission.VoteInSurveys))
        {
            <div class="survey-expired-notice">
                <strong>Du darfst an dieser Abstimmung nicht teilnehmen.</strong>
                <p>
                    Lehrer und Admins können Umfragen einsehen, aber keine Stimmen abgeben.
                </p>
            </div>
        }

        <p class="survey-detail-description">@Survey.Description</p>

        <div class="survey-detail-meta">
            <div>
                <strong>@Survey.Questions.Count</strong>
                <span>Fragen</span>
            </div>
        </div>

        <div class="survey-question-list">
            @for (var questionIndex = 0; questionIndex < Survey.Questions.Count; questionIndex++)
            {
                var currentIndex = questionIndex;
                var question = Survey.Questions[currentIndex];

                <article class="survey-question-block @(!CanVote ? "survey-question-block-disabled" : "")">
                    <h3>Frage @(currentIndex + 1)</h3>
                    <p>@question.Question</p>

                    <div class="survey-answer-list">
                        @for (var answerIndex = 0; answerIndex < question.AnswerModels.Count; answerIndex++)
                        {
                            var answer = question.AnswerModels[answerIndex];

                            <label class="survey-answer-option @(!CanVote || hasSubmitted ? "survey-answer-option-disabled" : "")">
                                <input type="radio"
                                       name="question-@currentIndex"
                                       value="@answer.Id"
                                       @onclick="@(() => OnAnswerSelected(currentIndex, answer.Id))"
                                       checked="@((selectedAnswers.ContainsKey(currentIndex) && selectedAnswers[currentIndex] == answer.Id))"
                                       disabled="@(!CanVote || hasSubmitted)" />
                                <span>@answer.Answers</span>
                            </label>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="survey-detail-actions">
            @if (CanVote)
            {
                <button type="button" class="sf-button sf-button-dark" @onclick="SubmitAnswers" disabled="@hasSubmitted">
                    @((hasSubmitted) ? "Antworten gesendet" : "Antworten absenden")
                </button>

                <a href="/survey" class="sf-button">
                    Zurück zu den Umfragen
                </a>
            }
            else
            {
                <button type="button" class="sf-button sf-button-dark" disabled>
                    Abstimmung geschlossen
                </button>

                <a href="/survey/results/@Survey.Id" class="sf-button">
                    Ergebnisse ansehen
                </a>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public int SurveyId { get; set; }

    private SurveyModel? Survey => surveyStateService.GetAllSurveys().FirstOrDefault(s => s.Id == SurveyId);

    private UserModel CurrentUser => userStateService.GetUser();

    private bool IsExpired =>
        Survey is not null &&
        Survey.OnlineUntil < DateOnly.FromDateTime(DateTime.Today);

    private int? CurrentUserId => userStateService?.GetUser()?.Id;

    private bool HasParticipated => Survey is not null && CurrentUserId.HasValue && Survey.UserIDs != null && Survey.UserIDs.Contains(CurrentUserId.Value);

    private bool CanVote =>
        Survey is not null &&
        !IsExpired &&
        PermissionRules.HasPermission(CurrentUser, Permission.VoteInSurveys) &&
        !HasParticipated;

    // Hier wurde das Layout der Variablen korrigiert:
    private Dictionary<int, int> selectedAnswers = new(); // Key: questionIndex, Value: answerId
    private bool hasSubmitted = false;

    protected override void OnInitialized()
    {
        userStateService.OnChange += HandleStateChanged;
        // mark as submitted if user already participated
        if (HasParticipated)
        {
            hasSubmitted = true;
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetSurveyStatusText()
    {
        if (IsExpired)
        {
            return "Abgelaufene Umfrage";
        }

        if (!PermissionRules.HasPermission(CurrentUser, Permission.VoteInSurveys))
        {
            return "Nur zur Ansicht";
        }

        return "Umfrage";
    }

    public void Dispose()
    {
        userStateService.OnChange -= HandleStateChanged;
    }

    private void OnAnswerSelected(int questionIndex, int answerId)
    {
        selectedAnswers[questionIndex] = answerId;
    }

    private async Task SubmitAnswers()
    {
        if (Survey == null) return;

        // Sicherstellen, dass jede Frage beantwortet wurde
        for (var i = 0; i < Survey.Questions.Count; i++)
        {
            if (!selectedAnswers.ContainsKey(i))
            {
                // Bricht ab, wenn eine Frage fehlt (hier könnte noch ein UI-Hinweis rein)
                return;
            }
        }
        var answerIds = selectedAnswers.Values.ToList();
        // Antworten an das Backend senden
        var ok = await surveyService.VoteForAnswers(answerIds, CurrentUser.Id);

        if (ok)
        {
            hasSubmitted = true;
            StateHasChanged();
        }
    }
}