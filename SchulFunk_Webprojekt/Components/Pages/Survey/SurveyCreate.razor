@page "/survey/create"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@inject UserService userService
@inject UserStateService userStateService
@inject SurveyService surveyService
@inject NavigationManager navigationManager
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Umfrage erstellen</PageTitle>

@if (!CanCreateSurveys)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine Umfragen erstellen.</p>
    </section>
}
else
{
    <section class="survey-create-layout">
        <div class="survey-create-form sf-panel">
            <div class="form-group">
                <label for="survey-title">Thema / Überschrift</label>
                <input id="survey-title"
                       type="text"
                       class="form-control"
                       placeholder="Zum Beispiel: Gestaltung der Pausenbereiche"
                       @bind="surveyModel.Title"
                       @bind:event="oninput" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Erstellt von</label>
                    <div class="readonly-info-box">
                        <strong>@CreatorName</strong>
                        <span>@UserRole</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Erstellt am</label>
                    <div class="readonly-info-box">
                        <strong>@DateTime.Today.ToString("dd.MM.yyyy")</strong>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="survey-online-until">Ablaufdatum</label>
                <input id="survey-online-until"
                       type="date"
                       class="form-control"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       @bind="DateForBinding" />

                @if (surveyModel.OnlineUntil <= DateOnly.FromDateTime(DateTime.Today))
                {
                    <small class="validation-message">
                        Das Ablaufdatum muss nach dem heutigen Tag liegen.
                    </small>
                }
            </div>

            <div class="form-group">
                <label for="survey-description">Beschreibung / Beweggrund</label>
                <textarea id="survey-description"
                          class="form-control"
                          rows="4"
                          placeholder="Warum wird diese Umfrage erstellt?"
                          @bind="surveyModel.Description"
                          @bind:event="oninput"></textarea>
            </div>

            @if (CurrentUser?.Group is Groups.Teacher or Groups.Admin)
            {
                <div class="form-group">
                    <label>Klassen auswählen</label>
                    <div class="class-selection-grid">
                        @foreach (var klasse in AvailableClasses)
                        {
                            <label class="class-checkbox">
                                <input type="checkbox"
                                       checked="@IstKlasseAusgewaehlt(klasse)"
                                       @onchange="() => ToggleClass(klasse)" />
                                <span>@klasse.Classname</span>
                            </label>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Zielgruppe</label>
                    <div class="readonly-info-box">
                        <strong>@ZielgruppenText</strong>
                    </div>
                </div>
            }

            <div class="question-section-header">
                <div>
                    <h3>Fragen</h3>
                    <p>Füge beliebig viele Fragen und Antwortmöglichkeiten hinzu.</p>
                </div>
                <button type="button" class="sf-button sf-button-dark" @onclick="AddQuestion">+ Frage hinzufügen</button>
            </div>

            <div class="question-list">
                @for (var questionIndex = 0; questionIndex < surveyModel.Questions.Count; questionIndex++)
                {
                    var currentQuestionIndex = questionIndex;
                    var question = surveyModel.Questions[currentQuestionIndex];

                    <article class="question-editor">
                        <div class="question-editor-header">
                            <h4>Frage @(currentQuestionIndex + 1)</h4>
                            @if (surveyModel.Questions.Count > 1)
                            {
                                <button type="button" class="remove-button" @onclick="() => RemoveQuestion(currentQuestionIndex)">Entfernen</button>
                            }
                        </div>
                        <div class="form-group">
                            <label>Fragetext</label>
                            <input type="text" class="form-control" placeholder="Frage eingeben" @bind="question.Question" @bind:event="oninput" />
                        </div>
                        <div class="answer-list">
                            <label>Antwortmöglichkeiten</label>
                            @for (var answerIndex = 0; answerIndex < question.AnswerModels.Count; answerIndex++)
                            {
                                var currentAnswerIndex = answerIndex;
                                var answer = question.AnswerModels[currentAnswerIndex];
                                <div class="answer-row">
                                    <input type="text" class="form-control" placeholder="Antwortmöglichkeit eingeben" @bind="answer.Answers" @bind:event="oninput" />
                                    @if (question.AnswerModels.Count > 2)
                                    {
                                        <button type="button" class="remove-answer-button" @onclick="() => RemoveAnswer(currentQuestionIndex, currentAnswerIndex)">✕</button>
                                    }
                                </div>
                            }
                            <button type="button" class="add-answer-button" @onclick="() => AddAnswer(currentQuestionIndex)">+ Antwort hinzufügen</button>
                        </div>
                    </article>
                }
            </div>

            <div class="form-actions">
                <button type="button" class="sf-button sf-button-dark" @onclick="UmfrageVeroeffentlichen">Umfrage veröffentlichen</button>
            </div>
        </div>

        <aside class="survey-create-preview sf-panel">
            <span class="preview-label">Live Vorschau</span>
            <h3>@(string.IsNullOrWhiteSpace(surveyModel.Title) ? "Umfragetitel" : surveyModel.Title)</h3>
            <div class="preview-meta">
                <span>@CreatorName</span>
                <span>@DateTime.Today.ToString("dd.MM.yyyy")</span>
                <span>bis @surveyModel.OnlineUntil.ToString("dd.MM.yyyy")</span>
            </div>
            <p>@(string.IsNullOrWhiteSpace(surveyModel.Description) ? "Hier erscheint später der Beweggrund..." : surveyModel.Description)</p>
            <div class="preview-classes">
                <strong>Klassen:</strong>
                <span>@(SelectedClasses.Count == 0 ? "Keine Auswahl" : string.Join(", ", SelectedClasses.Select(k => k.Classname)))</span>
            </div>
            <div class="preview-questions">
                @foreach (var q in surveyModel.Questions)
                {
                    <div class="preview-question">
                        <h4>@(string.IsNullOrWhiteSpace(q.Question) ? "Neue Frage" : q.Question)</h4>
                        @foreach (var a in q.AnswerModels)
                        {
                            <div class="preview-answer">@(string.IsNullOrWhiteSpace(a.Answers) ? "Antwort..." : a.Answers)</div>
                        }
                    </div>
                }
            </div>
        </aside>
    </section>
}

@code {
    private SurveyModel surveyModel = new() { Questions = new() { new QuestionModel { AnswerModels = new() { new(), new() } } } };

    // Bindungshilfe für das Date-Input
    private DateTime DateForBinding
    {
        get => surveyModel.OnlineUntil.ToDateTime(TimeOnly.MinValue);
        set => surveyModel.OnlineUntil = DateOnly.FromDateTime(value);
    }

    private UserModel? CurrentUser => userStateService.GetUser();
    private bool CanCreateSurveys => CurrentUser != null && PermissionRules.HasPermission(CurrentUser, Permission.CreateSurveys);
    private string CreatorName => CurrentUser != null ? $"{CurrentUser.Lastname} {CurrentUser.Firstname}".Trim() : "";
    private string UserRole => CurrentUser != null ? PermissionRules.GetGroupLabel(CurrentUser.Group) : "";
    private string ZielgruppenText => CurrentUser?.Group switch { Groups.StudentRepresentatives => "Alle Klassen", Groups.ClassRepresentatives => $"Nur Klasse {CurrentUser.Class?.Classname}", _ => "Manuell" };

    private List<ClassModel> AvailableClasses = new();
    private List<ClassModel> SelectedClasses = new();

    protected override async Task OnInitializedAsync()
    {
        var classes = await userService.GetAllClasses();
        AvailableClasses = classes ?? new();

        surveyModel.OnlineUntil = DateOnly.FromDateTime(DateTime.Today.AddDays(14));

        // Logik für die automatische Klassen-Vorauswahl
        if (CurrentUser != null)
        {
            if (CurrentUser.Group == Groups.StudentRepresentatives)
            {
                // Alle Klassen auswählen
                SelectedClasses = new List<ClassModel>(AvailableClasses);
            }
            else if (CurrentUser.Group == Groups.ClassRepresentatives && CurrentUser.Class != null)
            {
                // Nur die eigene Klasse auswählen
                var myClass = AvailableClasses.FirstOrDefault(c => c.Classname == CurrentUser.Class.Classname);
                if (myClass != null)
                {
                    SelectedClasses = new List<ClassModel> { myClass };
                }
            }
        }
    }

    private bool IstKlasseAusgewaehlt(ClassModel k) => SelectedClasses.Any(s => s.Classname == k.Classname);
    private void ToggleClass(ClassModel k) { if (IstKlasseAusgewaehlt(k)) SelectedClasses.RemoveAll(s => s.Classname == k.Classname); else SelectedClasses.Add(k); }
    private void AddQuestion() => surveyModel.Questions.Add(new QuestionModel { AnswerModels = new() { new(), new() } });
    private void RemoveQuestion(int i) => surveyModel.Questions.RemoveAt(i);
    private void AddAnswer(int q) => surveyModel.Questions[q].AnswerModels.Add(new AnswerModel());
    private void RemoveAnswer(int q, int a) => surveyModel.Questions[q].AnswerModels.RemoveAt(a);

    private async Task UmfrageVeroeffentlichen()
    {
        if (CurrentUser == null || !CanCreateSurveys || surveyModel.OnlineUntil <= DateOnly.FromDateTime(DateTime.Today)) return;
        surveyModel.CreatedAt = DateOnly.FromDateTime(DateTime.Today);
        surveyModel.User = CurrentUser;
        surveyModel.Classes = SelectedClasses.Select(k => k.Classname).ToList();
        await surveyService.CreateSurvey(surveyModel);
        navigationManager.NavigateTo("/home");
    }
}