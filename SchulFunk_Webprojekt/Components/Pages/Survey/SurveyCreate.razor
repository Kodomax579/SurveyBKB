@page "/survey/create"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@inject ApiService apiService

<PageTitle>Umfrage erstellen</PageTitle>

@if (!CanCreateSurveys)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine Umfragen erstellen.</p>
    </section>
}
else
{
    <section class="survey-create-layout">
        <div class="survey-create-form sf-panel">
            <div class="form-group">
                <label for="survey-title">Thema / Überschrift</label>
                <input id="survey-title"
                       type="text"
                       class="form-control"
                       placeholder="Zum Beispiel: Gestaltung der Pausenbereiche"
                       @bind="SurveyTitle"
                       @bind:event="oninput" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Erstellt von</label>
                    <div class="readonly-info-box">
                        <strong>@CreatorName</strong>
                        <span>@UserRole</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Erstellt am</label>
                    <div class="readonly-info-box">
                        <strong>@CreatedAt.ToString("dd.MM.yyyy")</strong>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="survey-online-until">Ablaufdatum</label>
                <input id="survey-online-until"
                       type="date"
                       class="form-control"
                       min="@MinimumOnlineUntil.ToString("yyyy-MM-dd")"
                       @bind="OnlineUntil" />

                @if (OnlineUntil <= CreatedAt)
                {
                    <small class="validation-message">
                        Das Ablaufdatum muss nach dem heutigen Tag liegen.
                    </small>
                }
            </div>

            <div class="form-group">
                <label for="survey-description">Beschreibung / Beweggrund</label>
                <textarea id="survey-description"
                          class="form-control"
                          rows="4"
                          placeholder="Warum wird diese Umfrage erstellt?"
                          @bind="Description"
                          @bind:event="oninput"></textarea>
            </div>

            @if (CurrentUser.Group is Groups.Teacher or Groups.Admin)
            {
                <div class="form-group">
                    <label>Klassen auswählen</label>

                    <div class="class-selection-grid">
                        @foreach (var klasse in AvailableClasses)
                        {
                            <label class="class-checkbox">
                                <input type="checkbox"
                                       checked="@IstKlasseAusgewaehlt(klasse)"
                                       @onchange="() => ToggleClass(klasse)" />

                                <span>@klasse.ClassName</span>
                            </label>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Zielgruppe</label>
                    <div class="readonly-info-box">
                        <strong>@ZielgruppenText</strong>
                    </div>
                </div>
            }

            <div class="question-section-header">
                <div>
                    <h3>Fragen</h3>
                    <p>Füge beliebig viele Fragen und Antwortmöglichkeiten hinzu.</p>
                </div>

                <button type="button" class="sf-button sf-button-dark" @onclick="AddQuestion">
                    + Frage hinzufügen
                </button>
            </div>

            <div class="question-list">
                @for (var questionIndex = 0; questionIndex < Questions.Count; questionIndex++)
                {
                    var currentQuestionIndex = questionIndex;
                    var question = Questions[currentQuestionIndex];

                    <article class="question-editor">
                        <div class="question-editor-header">
                            <h4>Frage @(currentQuestionIndex + 1)</h4>

                            @if (Questions.Count > 1)
                            {
                                <button type="button"
                                        class="remove-button"
                                        @onclick="() => RemoveQuestion(currentQuestionIndex)">
                                    Entfernen
                                </button>
                            }
                        </div>

                        <div class="form-group">
                            <label>Fragetext</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Frage eingeben"
                                   @bind="question.Question"
                                   @bind:event="oninput" />
                        </div>

                        <div class="answer-list">
                            <label>Antwortmöglichkeiten</label>

                            @for (var answerIndex = 0; answerIndex < question.Option.Count; answerIndex++)
                            {
                                var currentAnswerIndex = answerIndex;
                                var answer = question.Option[currentAnswerIndex];

                                <div class="answer-row">
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Antwortmöglichkeit eingeben"
                                           @bind="answer.Answers"
                                           @bind:event="oninput" />

                                    @if (question.Option.Count > 2)
                                    {
                                        <button type="button"
                                                class="remove-answer-button"
                                                @onclick="() => RemoveAnswer(currentQuestionIndex, currentAnswerIndex)">
                                            ✕
                                        </button>
                                    }
                                </div>
                            }

                            <button type="button"
                                    class="add-answer-button"
                                    @onclick="() => AddAnswer(currentQuestionIndex)">
                                + Antwort hinzufügen
                            </button>
                        </div>
                    </article>
                }
            </div>

            <div class="form-actions">
                <button type="button"
                        class="sf-button sf-button-dark"
                        @onclick="UmfrageVeroeffentlichen">
                    Umfrage veröffentlichen
                </button>
            </div>
        </div>

        <aside class="survey-create-preview sf-panel">
            <span class="preview-label">Live Vorschau</span>

            <div class="preview-icon">
                <img src="/lib/images/Icon-Survey.png" alt="Umfrage Icon" />
            </div>

            <h3>@(string.IsNullOrWhiteSpace(SurveyTitle) ? "Umfragetitel" : SurveyTitle)</h3>

            <div class="preview-meta">
                <span>@CreatorName</span>
                <span>@CreatedAt.ToString("dd.MM.yyyy")</span>
                <span>bis @OnlineUntil.ToString("dd.MM.yyyy")</span>
            </div>

            <p>
                @(string.IsNullOrWhiteSpace(Description)
                    ? "Hier erscheint später der Beweggrund oder die Beschreibung der Umfrage."
                    : Description)
            </p>

            <div class="preview-classes">
                <strong>Klassen:</strong>

                @if (SelectedClasses.Count == 0)
                {
                    <span>Keine Klasse ausgewählt</span>
                }
                else
                {
                    <span>@string.Join(", ", SelectedClasses.Select(klasse => klasse.ClassName))</span>
                }
            </div>

            <div class="preview-questions">
                @foreach (var question in Questions)
                {
                    <div class="preview-question">
                        <h4>@(string.IsNullOrWhiteSpace(question.Question) ? "Neue Frage" : question.Question)</h4>

                        @foreach (var answer in question.Option)
                        {
                            <div class="preview-answer">
                                @(string.IsNullOrWhiteSpace(answer.Answers) ? "Antwortmöglichkeit" : answer.Answers)
                            </div>
                        }
                    </div>
                }
            </div>
        </aside>
    </section>
}

@code {
    private string SurveyTitle = "";
    private string Description = "";

    private DateTime CreatedAt = DateTime.Today;
    private DateTime OnlineUntil = DateTime.Today.AddDays(14);
    private DateTime MinimumOnlineUntil => CreatedAt.AddDays(1);

    private UserModel CurrentUser => TestLoginData.CurrentUser;

    private bool CanCreateSurveys =>
        PermissionRules.HasPermission(CurrentUser, Permission.CreateSurveys);

    private string CreatorName =>
        $"{CurrentUser.Name} {CurrentUser.Lastname}".Trim();

    private string UserRole =>
        PermissionRules.GetGroupLabel(CurrentUser.Group);

    private string UserClass =>
        CurrentUser.Class.ClassName;

    private string ZielgruppenText =>
        CurrentUser.Group switch
        {
            Groups.StudentRepresentatives => "Alle Klassen",
            Groups.ClassRepresentatives => $"Nur Klasse {UserClass}",
            _ => "Klassen manuell auswählen"
        };

    private List<ClassModel> AvailableClasses = new();
    private List<ClassModel> SelectedClasses = new();

    private List<QuestionModel> Questions = new()
    {
        new QuestionModel
        {
            Question = "",
            Option = new()
            {
                new AnswerModel(),
                new AnswerModel()
            }
        }
    };

    protected override void OnInitialized()
    {
        if (CurrentUser.Group == Groups.StudentRepresentatives)
        {
            SelectedClasses = AvailableClasses.ToList();
        }
        else if (CurrentUser.Group == Groups.ClassRepresentatives)
        {
            var eigeneKlasse = AvailableClasses.FirstOrDefault(klasse => klasse.ClassName == UserClass);

            if (eigeneKlasse is not null)
            {
                SelectedClasses = new List<ClassModel> { eigeneKlasse };
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AvailableClasses = await apiService.GetFromJsonAsync<List<ClassModel>>("/api/User/classes");
    }

    private bool IstKlasseAusgewaehlt(ClassModel klasse)
    {
        return SelectedClasses.Any(selected => selected.ClassName == klasse.ClassName);
    }

    private void ToggleClass(ClassModel klasse)
    {
        if (IstKlasseAusgewaehlt(klasse))
        {
            SelectedClasses.RemoveAll(selected => selected.ClassName == klasse.ClassName);
            return;
        }

        SelectedClasses.Add(klasse);
    }

    private void AddQuestion()
    {
        Questions.Add(new QuestionModel
        {
            Question = "",
            Option = new()
            {
                new AnswerModel(),
                new AnswerModel()
            }
        });
    }

    private void RemoveQuestion(int questionIndex)
    {
        if (Questions.Count > 1)
        {
            Questions.RemoveAt(questionIndex);
        }
    }

    private void AddAnswer(int questionIndex)
    {
        Questions[questionIndex].Option.Add(new AnswerModel());
    }

    private void RemoveAnswer(int questionIndex, int answerIndex)
    {
        if (Questions[questionIndex].Option.Count > 2)
        {
            Questions[questionIndex].Option.RemoveAt(answerIndex);
        }
    }

    private void UmfrageVeroeffentlichen()
    {
        if (!CanCreateSurveys || OnlineUntil <= CreatedAt)
        {
            return;
        }
     
        SurveyTitle = "";
        Description = "";
        OnlineUntil = DateTime.Today.AddDays(14);
        Questions = new()
        {
            new QuestionModel
            {
                Question = "",
                Option = new()
                {
                    new AnswerModel(),
                    new AnswerModel()
                }
            }
        };
    }
}