@using SchulFunk_Webprojekt.Model
@inject SchulFunk_Webprojekt.Feature.UserHandling.UserStateService userStateService

<article class="survey-card @(IsExpired ? "is-ended" : "is-active")">

    <div class="survey-header">
        <div class="status-badge">
            @(IsExpired ? "Abgelaufen" : "Aktiv")
        </div>

        <div class="expiry-pill">
            @(IsExpired ? "Ende: " : "Läuft bis: ") @Item.OnlineUntil.ToString("dd.MM.yyyy")
        </div>
    </div>

    <div class="survey-body">
        <h3>@Item.Title</h3>
        <p>@Item.Description</p>
    </div>

    <div class="survey-footer">
        <div class="stats">
            <span class="stat-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                @TeilnehmerAnzahl
            </span>
            <span class="stat-item" title="Erstellt von">
                @Item.CreatorName
            </span>
        </div>

        @if (CanClick)
        {
            <a href="@ActionLink" class="action-btn">@ActionText</a>
        }
        else
        {
            <span class="action-btn disabled">@ActionText</span>
        }
    </div>

</article>

@code {
    [Parameter]
    public SurveyModel Item { get; set; } = new();

    // Aktuellen Benutzer abrufen
    private UserModel CurrentUser => userStateService.GetUser();
    private int? CurrentUserId => CurrentUser?.Id;

    private bool IsTeacherOrAdmin =>
        CurrentUser?.Group == Groups.Teacher || CurrentUser?.Group == Groups.Admin;

    // Prüfen, ob die Umfrage abgelaufen ist
    private bool IsExpired =>
        Item.OnlineUntil < DateOnly.FromDateTime(DateTime.Today);

    // Prüfen, ob der Nutzer bereits teilgenommen hat
    private bool HasParticipated =>
        CurrentUserId.HasValue && Item.UserIDs != null && Item.UserIDs.Contains(CurrentUserId.Value);

    // Klickbar, wenn: Umfrage abgelaufen ist ODER (Nutzer ist kein Lehrer/Admin UND hat noch nicht teilgenommen)
    private bool CanClick => IsExpired || (!IsTeacherOrAdmin && !HasParticipated);

    // Button-Text dynamisch festlegen
    private string ActionText
    {
        get
        {
            if (IsExpired) return "Ergebnisse ansehen";
            if (IsTeacherOrAdmin) return "Nur für Schüler";
            if (HasParticipated) return "Bereits teilgenommen";

            return "Jetzt abstimmen";
        }
    }

    // Link festlegen (Ergebnisse oder Abstimmung)
    private string ActionLink =>
        (IsExpired || HasParticipated || IsTeacherOrAdmin)
            ? $"/survey/results/{Item.Id}"
            : $"/survey/{Item.Id}";

    // Teilnehmeranzahl berechnen
    private int TeilnehmerAnzahl
    {
        get
        {
            if (Item.UserIDs != null)
            {
                return Item.UserIDs.Count;
            }

            if (Item.Questions is null || !Item.Questions.Any())
            {
                return 0;
            }

            return Item.Questions
                .Select(question => question.AnswerModels?.Sum(option => option.NumberOfSelectedAnswer) ?? 0)
                .DefaultIfEmpty(0)
                .Max();
        }
    }
}