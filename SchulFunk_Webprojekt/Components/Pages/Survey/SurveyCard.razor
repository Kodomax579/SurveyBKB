@using SchulFunk_Webprojekt.Model
@inject SchulFunk_Webprojekt.Feature.UserHandling.UserStateService userStateService

<article class="survey-card @(IsExpired ? "is-ended" : "is-active")">
    <div class="survey-card-meta">
        <span class="survey-card-status">
            @(IsExpired ? "BEENDET" : "AKTIV")
        </span>

        <span class="survey-card-participants" title="Anzahl der Teilnehmer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            @TeilnehmerAnzahl
        </span>
    </div>

    <h3 title="@Item.Title">@Item.Title</h3>

    <p class="survey-card-description">
        @Item.Description
    </p>

    <div class="survey-card-footer">
        @if (CanClick)
        {
            <a href="@ActionLink" class="survey-card-action">@ActionText</a>
        }
        else
        {
            <span class="survey-card-action survey-card-action-disabled">@ActionText</span>
        }
    </div>
</article>

@code {
    [Parameter]
    public SurveyModel Item { get; set; } = new();

    private bool IsExpired =>
        Item.OnlineUntil < DateOnly.FromDateTime(DateTime.Today);

    private int? CurrentUserId => userStateService?.GetUser()?.Id;

    private bool HasParticipated =>
        CurrentUserId.HasValue && Item.UserIDs != null && Item.UserIDs.Contains(CurrentUserId.Value);

    // Klickbar, wenn sie abgelaufen ist (Ergebnisse) ODER wenn aktiv und noch nicht teilgenommen
    private bool CanClick => IsExpired || !HasParticipated;

    private string ActionText =>
        IsExpired ? "Ergebnisse ansehen" : (HasParticipated ? "Bereits teilgenommen" : "Jetzt abstimmen");

    // Wenn abgelaufen ODER bereits teilgenommen, geht es zu den Ergebnissen
    private string ActionLink =>
        (IsExpired || HasParticipated) ? $"/survey/results/{Item.Id}" : $"/survey/{Item.Id}";

    private int TeilnehmerAnzahl
    {
        get
        {
            if (Item.UserIDs != null)
            {
                return Item.UserIDs.Count;
            }

            if (Item.Questions is null || !Item.Questions.Any())
            {
                return 0;
            }

            return Item.Questions
                .Select(question => question.AnswerModels?.Sum(option => option.NumberOfSelectedAnswer) ?? 0)
                .DefaultIfEmpty(0)
                .Max();
        }
    }
}