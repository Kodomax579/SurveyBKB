@page "/survey"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model

<PageTitle>Umfragen</PageTitle>

<section class="survey-page-header sf-panel">
    <div class="survey-search-box">
        <input type="text"
               class="survey-search-input"
               placeholder="Nach Umfrage suchen..."
               @bind="Suchtext"
               @bind:event="oninput" />
    </div>

    <a href="/survey/results" class="sf-button sf-button-dark survey-results-button">
        Ausgewertete Umfragen
    </a>
</section>

<section class="survey-card-grid">
    @foreach (var survey in GefilterteSurveyListe)
    {
        <SurveyCard Item="@survey" />
    }
</section>

@code {
    private string Suchtext = "";
    private List<SurveyModel> SurveyListe = SurveyData.SurveyListe;

    private IEnumerable<SurveyModel> GefilterteSurveyListe =>
        SurveyListe
            .Where(survey => survey.OnlineUntil >= DateOnly.FromDateTime(DateTime.Today))
            .Where(survey =>
                string.IsNullOrWhiteSpace(Suchtext) ||
                survey.Title.Contains(Suchtext, StringComparison.OrdinalIgnoreCase));
}