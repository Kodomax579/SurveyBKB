@page "/survey"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@inject SurveyStateService surveyStateService
@inject UserStateService userStateService
@implements IDisposable

<PageTitle>Umfragen</PageTitle>

<PageTitle>Umfragen</PageTitle>

<div class="survey-page-header">
   <div class="survey-search-wrapper">
        <Search Placeholder="Nach Umfragen suchen..." @bind-Value="Suchtext" />
    </div>
    <!-- Filter-Dropdown bleibt daneben -->
    <div class="survey-filter-box">
        <button type="button"
                class="survey-filter-button @(FilterDropdownOpen ? "open" : "")"
                @onclick="ToggleFilterDropdown">
            <span>@StatusFilterLabel</span>
            <span class="survey-filter-arrow"></span>
        </button>

        @if (FilterDropdownOpen)
        {
            <div class="survey-filter-menu">
                <button type="button" @onclick='() => SetStatusFilter("all")'>Alle Status</button>
                <button type="button" @onclick='() => SetStatusFilter("active")'>Nur Aktive</button>
                <button type="button" @onclick='() => SetStatusFilter("ended")'>Beendete</button>
            </div>
        }
    </div>
</div>

@{
    var sichtbareUmfragen = GefilterteSurveyListe.ToList();
}

@if (sichtbareUmfragen.Any())
{
    <section class="survey-card-grid">
        @foreach (var survey in sichtbareUmfragen)
        {
            <SurveyCard Item="@survey" />
        }
    </section>
}
else
{
    <section class="survey-empty-state sf-panel">
        <h3>Keine Umfragen gefunden</h3>
        <p>Für deine Suche oder den gewählten Filter gibt es aktuell keine passende Umfragen.</p>
    </section>
}

@code {
    [Parameter] public string SearchQuery { get; set; } = string.Empty;

    private string Suchtext = "";
    private string StatusFilter = "all";
    private bool FilterDropdownOpen = false;

    private List<SurveyModel> SurveyListe
    {
        get
        {
            var currentUser = userStateService.GetUser();
            var userClass = currentUser?.Class?.Classname;
            var isTeacher = currentUser?.Class.Classname == "Lehrer"; // Passe den Rollennamen ggf. an dein Model an

            return surveyStateService.GetAllSurveys()
                .Where(s =>
                    // 1. Lehrer sehen immer alles
                    isTeacher ||

                    // 2. Allgemeine Umfragen (keine Klassenbeschränkung)
                    s.Classes == null ||
                    s.Classes.Count == 0 ||

                    // 3. Umfragen für die eigene Klasse
                    (!string.IsNullOrWhiteSpace(userClass) && s.Classes.Contains(userClass))
                )
                .ToList();
        }
    }

    private IEnumerable<SurveyModel> GefilterteSurveyListe =>
        SurveyListe
            .Where(MatchesStatusFilter)
            .Where(MatchesSearch)
            .OrderBy(survey => IsExpired(survey) ? 1 : 0)
            .ThenByDescending(survey => survey.CreatedAt);

    protected override void OnInitialized()
    {
        surveyStateService.OnChange += HandleStateChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SearchQuery))
        {
            Suchtext = SearchQuery;
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool MatchesSearch(SurveyModel survey)
    {
        if (string.IsNullOrWhiteSpace(Suchtext))
        {
            return true;
        }

        return survey.Title.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) ||
               survey.Description.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) ||
               survey.CreatorName.Contains(Suchtext, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesStatusFilter(SurveyModel survey)
    {
        var isExpired = IsExpired(survey);

        return StatusFilter switch
        {
            "active" => !isExpired,
            "ended" => isExpired,
            _ => true
        };
    }

    private static bool IsExpired(SurveyModel survey)
    {
        return survey.OnlineUntil < DateOnly.FromDateTime(DateTime.Today);
    }

    private string StatusFilterLabel =>
        StatusFilter switch
        {
            "active" => "Nur Aktive",
            "ended" => "Beendete",
            _ => "Alle Status"
        };

    private void ToggleFilterDropdown()
    {
        FilterDropdownOpen = !FilterDropdownOpen;
    }

    private void SetStatusFilter(string filter)
    {
        StatusFilter = filter;
        FilterDropdownOpen = false;
    }

    public void Dispose()
    {
        surveyStateService.OnChange -= HandleStateChanged;
    }
}