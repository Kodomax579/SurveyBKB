@using SchulFunk_Webprojekt.Model
@inject IConfiguration configuration

<a href="/news/@Item.Id" class="news-card">
    <img src="@imageUrl"
         alt="@Item.Title"
         class="news-card-image @(HasImage ? "" : "news-card-image-default")" />

    <div class="news-card-body">
        <div class="news-card-meta">
            <span class="news-card-badge @BadgeClass">@Item.Tag</span>
            <span>@Item.CreatedAt</span>
        </div>

        <h3>@Item.Title</h3>

        <p>@Item.PreviewText</p>

        <span class="news-card-read-more">
            Mehr erfahren →
        </span>
    </div>
</a>

@code {
    [Parameter]
    public NewsItem Item { get; set; } = new();
    string imageUrl => $"{configuration.GetValue<string>("ApiSettings:BaseUrl")!}{Item.ImageLink}";
    private bool HasImage =>
        Item.ImageLink is not null && Item.ImageLink.Length > 0;

    private string ImageSource =>
        HasImage
            ? Item.ImageLink
            : "/lib/images/Icon-News.png";

    private string BadgeClass =>
        Item.Tag.ToLower() switch
        {
            "sport" => "is-sport",
            "schülervertretung" => "is-sv",
            "sv" => "is-sv",
            "kultur" => "is-kultur",
            "digitalisierung" => "is-tech",
            "technik" => "is-tech",
            _ => "is-default"
        };
}
