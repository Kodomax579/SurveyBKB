@rendermode InteractiveServer
@inject NewsService newsService
@inject NewsStateService newsStateService
@inject SignalRHub hub
@inject NavigationManager navigationManager
@implements IDisposable

<main class="bento-container">
    @if (newsStateService.GetNewsItems() != null)
    {
        @foreach (var item in GetFilteredNews().OrderByDescending(item => item.CreatedAt))
        {
            var cardSize = GetGridClass(item);
            var hasImage = !string.IsNullOrEmpty(item.ImageLink);
            var backgroundStyle = BackgroundStyle(item);

            <article class="card @cardSize @(hasImage ? "has-image" : "")"
                     style="@backgroundStyle"
                     @onclick="() => GoToNewsDetail(item.Id)"
                     role="button"
                     tabindex="0"
                     @onkeyup="@((KeyboardEventArgs e) => { if (e.Key == "Enter" || e.Key == " ") GoToNewsDetail(item.Id); })">

                @if (hasImage)
                {
                    <div class="image-overlay"></div>
                }

                <div class="card-content">
                    <div class="tag">@item.Tag</div>

                    @if (item.Prioritaet?.Equals("breaking", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        <h2>@item.Titel</h2>
                    }
                    else
                    {
                        <h3>@item.Titel</h3>
                    }

                    @if (cardSize == "hero" || cardSize == "tall")
                    {
                        <p class="preview-text">@item.PreviewText</p>
                    }

                    @if (cardSize != "small" && item.User != null)
                    {
                        <div class="author-info">
                            <img src="@(string.IsNullOrEmpty(item.User.ImageLink) ? "assets/default-avatar.png" : item.User.ImageLink)"
                                 alt="@item.User.Firstname"
                                 class="author-avatar" />

                            <div class="author-details">
                                <span class="author-name">@item.User.Firstname @item.User.Lastname</span>
                            </div>
                        </div>
                    }
                </div>
            </article>
        }
    }
</main>

@code {
    [Parameter] public string SearchQuery { get; set; } = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        newsStateService.OnChange += UpdateUI;
        await hub.Connect();
    }

    protected override void OnParametersSet()
    {
        StateHasChanged();
    }

    private List<NewsItem> GetFilteredNews()
    {
        var news = newsStateService.GetNewsItems() ?? new List<NewsItem>();

        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            return news.ToList();
        }

        var query = SearchQuery.ToLower().Trim();

        return news.Where(item =>
            (!string.IsNullOrEmpty(item.Titel) && item.Titel.ToLower().Contains(query)) ||
            (!string.IsNullOrEmpty(item.Tag) && item.Tag.ToLower().Contains(query))
        ).ToList();
    }

    private string GetGridClass(NewsItem item)
    {
        if (item.Prioritaet?.Equals("breaking", StringComparison.OrdinalIgnoreCase) == true)
        {
            return "hero";
        }
        if (!string.IsNullOrEmpty(item.ImageLink))
        {
            return "tall";
        }
        if (item.Titel?.Length > 60)
        {
            return "wide";
        }
        return "small";
    }

    private void UpdateUI() => InvokeAsync(StateHasChanged);

    private string? BackgroundStyle(NewsItem news)
    {
        var hasImage = !string.IsNullOrEmpty(news.ImageLink);

        if (hasImage)
        {
            if (news.ImageLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                return $"background-image: url('{news.ImageLink}');";
            }
            return $"background-image: url('https://schulfunk-bkbeckum.de/api{news.ImageLink}');";
        }

        return null;
    }

    private void GoToNewsDetail(int newsId)
    {
        navigationManager.NavigateTo($"/news/{newsId}");
    }

    public void Dispose()
    {
        newsStateService.OnChange -= UpdateUI;
    }
}