@rendermode InteractiveServer
@inject NewsService newsService
@inject SurveyService surveyService
@inject NewsStateService newsStateService
@inject SurveyStateService surveyStateService
@inject SignalRHub hub

<main class="bento-container">
    @if (newsStateService.GetNewsItems() != null)
    {
        @* Sortiert die News so, dass die neuesten Einträge (neuestes Erstellungsdatum) zuerst kommen *@
        @foreach (var item in newsStateService.GetNewsItems().OrderBy(item => item.CreatedAt))
        {
            var cardSize = GetGridClass(item);
            var hasImage = !string.IsNullOrEmpty(item.ImageLink);
            var backgroundStyle = BackgroundStyle(item);

            <article class="card @cardSize @(hasImage ? "has-image" : "")" style="@backgroundStyle">

                @if (hasImage)
                {
                    <div class="image-overlay"></div>
                }

                <div class="card-content">
                    <div class="tag">@item.Tag</div>

                    @if (item.Prioritaet?.Equals("breaking", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        <h2>@item.Titel</h2>
                    }
                    else
                    {
                        <h3>@item.Titel</h3>
                    }

                    @if (cardSize == "hero" || cardSize == "tall")
                    {
                        <p class="preview-text">@item.PreviewText</p>
                    }

                    @if (cardSize != "small" && item.User != null)
                    {
                        <div class="author-info">
                            <img src="@(string.IsNullOrEmpty(item.User.ImageLink) ? "assets/default-avatar.png" : item.User.ImageLink)"
                                 alt="@item.User.Firstname"
                                 class="author-avatar" />

                            <div class="author-details">
                                <span class="author-name">@item.User.Firstname @item.User.Lastname</span>
                                @if (!string.IsNullOrEmpty(item.User.Class?.Classname))
                                {
                                    <span class="author-class">@item.User.Class.Classname</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </article>
        }
    }
</main>

@code {
    private int AktuelleUmfrageIndex = 0;
    private string SurveyAnimationClass = "slide-in";
    private List<SurveyModel> surveyModels => surveyStateService.GetAllSurveys().Take(3).ToList();

    protected async override Task OnInitializedAsync()
    {
        newsStateService.OnChange += UpdateUI;
        surveyStateService.OnChange += UpdateUI;
        await hub.Connect();
    }

    // Hilfsmethode zur Bestimmung der Kachelgröße basierend auf Priorität oder Bild
    private string GetGridClass(NewsItem item)
    {
        if (item.Prioritaet?.Equals("breaking", StringComparison.OrdinalIgnoreCase) == true)
        {
            return "hero";
        }
        if (!string.IsNullOrEmpty(item.ImageLink))
        {
            return "tall";
        }
        if (item.Titel?.Length > 60)
        {
            return "wide";
        }
        return "small";
    }

    private void UpdateUI() => InvokeAsync(StateHasChanged);

    private async Task NaechsteUmfrage()
    {
        if (!surveyModels.Any()) return;
        SurveyAnimationClass = "slide-out-up";
        await Task.Delay(140);
        AktuelleUmfrageIndex = (AktuelleUmfrageIndex + 1) % surveyModels.Count;
        SurveyAnimationClass = "slide-in";
    }

    private async Task VorherigeUmfrage()
    {
        if (!surveyModels.Any()) return;
        SurveyAnimationClass = "slide-out-down";
        await Task.Delay(140);
        AktuelleUmfrageIndex = (AktuelleUmfrageIndex - 1 + surveyModels.Count) % surveyModels.Count;
        SurveyAnimationClass = "slide-in";
    }

    private int BerechneProzent(QuestionModel question, AnswerModel answer)
    {
        var gesamtStimmen = question.AnswerModels.Sum(option => option.NumberOfSelectedAnswer);
        if (gesamtStimmen == 0) return 0;
        return (int)Math.Round((double)answer.NumberOfSelectedAnswer / gesamtStimmen * 100);
    }

    private int HoechsterProzentwert(QuestionModel question)
    {
        if (!question.AnswerModels.Any()) return 0;
        return question.AnswerModels.Select(answer => BerechneProzent(question, answer)).Max();
    }

    private string? BackgroundStyle(NewsItem news)
    {
        var hasImage = !string.IsNullOrEmpty(news.ImageLink);

        if(hasImage)
        {
            if (news.ImageLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                return $"background-image: url('{news.ImageLink}');";
            }
            return $"background-image: url('http://212.227.82.199:7224{news.ImageLink}');";
        }

        return null;
    }

    public void Dispose()
    {
        newsStateService.OnChange -= UpdateUI;
        surveyStateService.OnChange -= UpdateUI;
    }
}