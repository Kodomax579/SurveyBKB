@page "/news/create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using SchulFunk_Webprojekt.Model
@inject UserStateService userStateService
@inject NewsService newsService
@inject NavigationManager navigationManager

<PageTitle>Nachricht erstellen</PageTitle>

@if (!CanCreateNews)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine Nachrichten erstellen.</p>
    </section>
}
else
{
    <section class="news-create-layout">
        <div class="news-create-form sf-panel">
            <div class="form-group">
                <label for="news-title">Titel</label>
                <input id="news-title"
                       type="text"
                       class="form-control"
                       placeholder="Titel der Nachricht eingeben"
                       @bind="newsItem.Titel"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label for="news-tag">Tag</label>
                <input id="news-tag"
                       type="text"
                       class="form-control"
                       placeholder="Zum Beispiel: Schulnews, Projektwoche, Wichtig"
                       @bind="newsItem.Tag"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label for="news-priority">Priorität (Bento-Grid Steuerung)</label>
                <select id="news-priority" class="form-control" @bind="newsItem.Prioritaet">
                    <option value="standard">Standard (Kleine / Mittlere Kachel)</option>
                    <option value="breaking">Breaking News (Große Hero-Kachel)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="news-description">Kurzbeschreibung</label>
                <textarea id="news-description"
                          class="form-control"
                          rows="4"
                          placeholder="Kurze Beschreibung der Nachricht eingeben"
                          @bind="newsItem.PreviewText"
                          @bind:event="oninput"></textarea>
            </div>

            <div class="form-group">
                <label for="news-artikel">Kompletter Artikel</label>
                <textarea id="news-artikel"
                          class="form-control"
                          rows="8"
                          placeholder="Hier kommt später der komplette Artikeltext rein"
                          @bind="newsItem.MainText"
                          @bind:event="oninput"></textarea>
            </div>

            <div class="form-group">
                <label for="news-image">Bild hochladen</label>

                <label class="image-upload-box" for="news-image">
                    <img src="/lib/images/Icon-News.png" alt="" />
                    <span>Bild auswählen</span>
                    <small>PNG, JPG oder JPEG</small>
                </label>

                <InputFile id="news-image"
                           class="image-upload-input"
                           style="display: none;"
                           hidden
                           accept="image/png,image/jpeg,image/jpg"
                           OnChange="BildAusgewaehlt" />
            </div>

            <div class="form-actions">
                <button type="button"
                        class="sf-button sf-button-dark"
                        @onclick="ArtikelVeroeffentlichen">
                    Artikel veröffentlichen
                </button>
            </div>
        </div>

        <aside class="news-create-preview sf-panel">
            <span class="preview-label">Vorschau</span>

            <div class="preview-image">
                @if (!string.IsNullOrWhiteSpace(BildVorschauUrl))
                {
                    <img src="@BildVorschauUrl" alt="Bildvorschau" />
                }
                else
                {
                    <img src="/lib/images/Icon-News.png" alt="Standard News Icon" />
                }
            </div>

            @* Wenn die Priorität auf 'breaking' steht, wird der Titel wie im Grid als h2 gerendert *@
            @if (newsItem.Prioritaet?.Equals("breaking", StringComparison.OrdinalIgnoreCase) == true)
            {
                <h2 class="preview-breaking-title">@(string.IsNullOrWhiteSpace(newsItem.Titel) ? "Nachrichtentitel" : newsItem.Titel)</h2>
            }
            else
            {
                <h3>@(string.IsNullOrWhiteSpace(newsItem.Titel) ? "Nachrichtentitel" : newsItem.Titel)</h3>
            }

            <span class="preview-tag">
                @(string.IsNullOrWhiteSpace(newsItem.Tag) ? "Tag" : newsItem.Tag)
            </span>

            <p>
                @(string.IsNullOrWhiteSpace(newsItem.PreviewText)
                    ? "Hier wird später eine Vorschau der Nachricht angezeigt."
                    : newsItem.PreviewText)
            </p>
        </aside>
    </section>
}

@code {
    private NewsItem newsItem = new()
    {
        // Standardwert setzen, damit beim Absenden ohne Änderung etwas eingetragen ist
        CreatedAt = DateTime.Now,
        Prioritaet = "standard"
    };

    private string BildVorschauUrl = "";
    private byte[] BildBytes = Array.Empty<byte>();
    private IBrowserFile? AusgewaehlteBildDatei;

    private UserModel CurrentUser => userStateService.GetUser();

    private bool CanCreateNews =>
        PermissionRules.HasPermission(CurrentUser, Permission.CreateNews);

    private async Task BildAusgewaehlt(InputFileChangeEventArgs e)
    {
        var datei = e.File;

        if (datei is null)
        {
            return;
        }

        AusgewaehlteBildDatei = datei;

        using var stream = datei.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var memoryStream = new MemoryStream();

        await stream.CopyToAsync(memoryStream);

        BildBytes = memoryStream.ToArray();
        var base64 = Convert.ToBase64String(BildBytes);

        BildVorschauUrl = $"data:{datei.ContentType};base64,{base64}";
    }

    private async Task ArtikelVeroeffentlichen()
    {
        newsItem.User = CurrentUser;
        var result = await newsService.CreateNews(newsItem, AusgewaehlteBildDatei);

        if(result)
        {
            navigationManager.NavigateTo("/home");
        }
    }
}