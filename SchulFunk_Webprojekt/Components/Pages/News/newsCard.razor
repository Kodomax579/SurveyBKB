@using SchulFunk_Webprojekt.Model

<article class="news-card">
    <div class="news-card-top">
        <img src="/lib/images/Icon-News.png" alt="News Icon" class="news-card-icon" />

        <div>
            <span class="news-card-category">@Item.Tag</span>
            <h3>@Item.Title</h3>
        </div>
    </div>

    <p>@Item.Description</p>

    <div class="news-card-footer">
        <span>@Item.Date</span>

        <a href="/news/@Item.Id" class="sf-button sf-button-dark">
            Mehr lesen
        </a>
    </div>
</article>

@code {
    [Parameter]
    public NewsItem Item { get; set; } = new();
}