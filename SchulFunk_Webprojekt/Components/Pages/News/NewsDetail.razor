@page "/news/{Id:int}"
@inject NewsStateService newsStateService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable
@inject IConfiguration configuration

<PageTitle>@(News?.Titel ?? "Nachricht")</PageTitle>

@if (News is null)
{
    <section class="news-detail-page sf-panel">
        <h2>Nachricht nicht gefunden</h2>
        <a href="/home" class="sf-button">Zurück zur Übersicht</a>
    </section>
}
else
{
    <section class="news-detail-wrapper">
        <article class="news-detail-content @(hasImage ? "has-image" : "")">

            @if (hasImage)
            {
                <div class="news-hero-image" style="background-image: url('@imageUrl')">
                    <div class="news-hero-overlay"></div>
                    <header class="news-hero-header">
                        <span class="news-tag">@News.Tag</span>
                        <h1>@News.Titel</h1>
                        <p class="news-date">@News.CreatedAt.ToString("dd. MMMM yyyy")</p>
                    </header>
                </div>
            }

            <div class="news-body">
                @if (!hasImage)
                {
                    <header class="news-simple-header">
                        <span class="news-tag">@News.Tag</span>
                        <h1>@News.Titel</h1>
                        <p class="news-date">@News.CreatedAt.ToString("dd. MMMM yyyy")</p>
                    </header>
                }

                <p class="news-preview">@News.PreviewText</p>
                <div class="news-article">
                    @News.MainText
                </div>

                <a href="/home" class="sf-button news-back-btn">← Zurück zu den Nachrichten</a>
            </div>
        </article>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private NewsItem? News => newsStateService.GetNewsItems().FirstOrDefault(n => n.Id == Id);
    private bool hasImage => !string.IsNullOrEmpty(News?.ImageLink);
    private string imageUrl => $"{configuration.GetValue<string>("ApiSettings:BaseUrl")!}{News?.ImageLink}";

    protected override void OnInitialized() => newsStateService.OnChange += HandleStateChanged;
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => newsStateService.OnChange -= HandleStateChanged;
}