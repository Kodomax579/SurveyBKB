@page "/news/{Id:int}"
@inject NewsStateService newsStateService
@implements IDisposable

<PageTitle>@(News?.Title ?? "Nachricht")</PageTitle>

@if (News is null)
{
    <section class="news-detail-page sf-panel">
        <h2>Nachricht nicht gefunden</h2>
        <p>Die gewünschte Nachricht konnte nicht gefunden werden.</p>

        <a href="/news" class="sf-button sf-button-dark">
            Zurück zu den Nachrichten
        </a>
    </section>
}
else
{
    <section class="news-detail-page sf-panel">
        <div class="news-detail-header">
            <img src="/lib/images/Icon-News.png" alt="News Icon" />

            <div>
                <span>@News.Tag</span>
                <h2>@News.Title</h2>
                <p>@News.CreatedAt</p>
            </div>
        </div>

        <p class="news-detail-description">
            @News.PreviewText
        </p>

        <article class="news-detail-article">
            @News.MainText
        </article>

        <a href="/news" class="sf-button sf-button-dark news-detail-back">
            Zurück zu den Nachrichten
        </a>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private NewsItem? News => newsStateService.GetNewsItems().FirstOrDefault(n => n.Id == Id);

    protected override void OnInitialized()
    {
        newsStateService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        newsStateService.OnChange -= HandleStateChanged;
    }
}
