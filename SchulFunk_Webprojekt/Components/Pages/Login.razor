@page "/"
@inject UserService userService
@inject SurveyService surveyService
@inject NewsService newsService
@layout EmptyLayout
@inject NavigationManager NavManager

<PageTitle>Login - SchulFunk</PageTitle>

<div class="sf-login-split-container">

    <!-- LINKE SPALTE: INFORMATIONEN & FEATURES -->
    <div class="sf-login-info-side">
        <div class="sf-login-info-content">
            <span class="sf-info-badge">SchulFunk Plattform</span>
            <h1>Immer auf dem Laufenden bleiben.</h1>
            <p class="sf-info-text">
                Willkommen zurück! SchulFunk ist das digitale Schwarze Brett deiner Schule.
                Nimm an aktuellen Umfragen teil, lies die neuesten Nachrichten aus dem Schulalltag
                und gestalte das Schulleben aktiv mit.
            </p>

            <!-- Kleine Bento-Mini-Kacheln für Mehrwert -->
            <div class="sf-login-mini-grid">
                <!-- Link 1: UNiTS -->
                <a href="https://bkbeckum.webuntis.com/WebUntis/?school=bkbeckum#/basic/login" target="_blank" class="mini-grid-item">
                    <img src="/lib/images/SchulFunk-Logo.png" alt="Stundenplan" />
                    <div class="link-text-container">
                        <strong>Gibt es Änderungen im Stundenplan?</strong>
                        <span>Gehe jetzt auf Untis</span>
                    </div>
                    <span class="link-arrow">→</span>
                </a>

                <!-- Link 2: Moodle -->
                <a href="https://bkb-ecampus.de/login/index.php" target="_blank" class="mini-grid-item">
                    <img src="/lib/images/SchulFunk-Logo.png" alt="Moodle" style="filter: hue-rotate(140deg);" />
                    <div class="link-text-container">
                        <strong>Aufgaben vergessen abzugeben?</strong>
                        <span>Geh jetzt auf Moodle und gib deine Aufgaben ab</span>
                    </div>
                    <span class="link-arrow">→</span>
                </a>

                <!-- Link 3: Erasmus -->
                <a href="https://bkb-erasmus.de/" target="_blank" class="mini-grid-item">
                    <img src="/lib/images/SchulFunk-Logo.png" alt="Erasmus" style="filter: hue-rotate(240deg);" />
                    <div class="link-text-container">
                        <strong>Lust auf ein Auslandspraktikum?</strong>
                        <span>Hier geht es zu der Erasmus-Seite vom Berufskolleg Beckum</span>
                    </div>
                    <span class="link-arrow">→</span>
                </a>
            </div>
        </div>

        <div class="sf-login-info-footer">
            Berufskolleg Beckum · IT-Projekt 2026
        </div>
    </div>

    <!-- RECHTE SPALTE: DAS EIGENTLICHE FORMULAR -->
    <div class="sf-login-form-side">
        <div class="auth-panel">
            <div class="auth-header">
                <img src="/favicon.png" alt="SchulFunk Logo" class="auth-logo" />
                <h2>Schul<span>Funk</span></h2>
                <p>Bitte melde dich an, um fortzufahren.</p>
            </div>

            <div class="auth-form">
                <div class="form-group">
                    <label>E-Mail Adresse</label>
                    <input type="email" class="sf-input" placeholder="schueler@schule.de" @bind-value="email" />
                </div>

                <div class="form-group">
                    <label>Passwort</label>
                    <input type="password" class="sf-input" placeholder="••••••••" @bind-value="password" />
                </div>

                @if (!string.IsNullOrWhiteSpace(Fehlermeldung))
                {
                    <div class="validation-message">
                        @Fehlermeldung
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Erfolgsmeldung))
                {
                    <div class="success-message">
                        @Erfolgsmeldung
                    </div>
                }

                <div class="form-actions-row">
                    <button type="button" class="sf-link-button" @onclick="OpenResetModal">
                        Passwort vergessen?
                    </button>
                </div>

                <button class="sf-button w-100 mt-2" @onclick="Einloggen">
                    Anmelden
                </button>
            </div>
        </div>
    </div>
</div>

@if (showResetModal)
{
    <div class="sf-modal-backdrop" @onclick="CloseResetModal">
        <div class="sf-panel sf-modal-content" @onclick:stopPropagation>
            <div class="auth-header text-center">
                <h3>Passwort <span>zurücksetzen</span></h3>
                <p>Gib deine E-Mail-Adresse ein. Wir senden dir einen Link, um dein Passwort zu ändern.</p>
            </div>

            <div class="form-group text-left">
                <label>Deine E-Mail Adresse</label>
                <input type="email" class="sf-input" placeholder="schueler@schule.de" @bind-value="resetEmail" />
            </div>

            @if (!string.IsNullOrWhiteSpace(modalError))
            {
                <div class="validation-message mb-3">
                    @modalError
                </div>
            }

            <div class="modal-actions">
                <button class="sf-button sf-button-secondary" @onclick="CloseResetModal" disabled="@isSending">
                    Abbrechen
                </button>
                <button class="sf-button" @onclick="SendeResetLink" disabled="@isSending">
                    @if (isSending)
                    {
                        <span>Wird gesendet...</span>
                    }
                    else
                    {
                        <span>Link anfordern</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string? email = null;
    private string? password = null;
    private string Fehlermeldung = "";
    private string Erfolgsmeldung = "";

    // Modal Status Variablen
    private bool showResetModal = false;
    private string resetEmail = "";
    private string modalError = "";
    private bool isSending = false;

    private async Task Einloggen()
    {
        Fehlermeldung = "";
        Erfolgsmeldung = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            Fehlermeldung = "Bitte E-Mail und Passwort eingeben.";
            return;
        }

        var loginOk = await userService.Login(email, password);

        if (!loginOk)
        {
            Fehlermeldung = "Login fehlgeschlagen. Bitte prüfe deine Zugangsdaten.";
            return;
        }

        await newsService.GetAllNews();
        await surveyService.GetAllSurveys();

        NavManager.NavigateTo("/home");
    }

    private void OpenResetModal()
    {
        resetEmail = "";
        modalError = "";
        showResetModal = true;
    }

    private void CloseResetModal()
    {
        if (!isSending)
        {
            showResetModal = false;
        }
    }

    private async Task SendeResetLink()
    {
        modalError = "";

        if (string.IsNullOrWhiteSpace(resetEmail))
        {
            modalError = "Bitte gib eine E-Mail-Adresse ein.";
            return;
        }

        isSending = true;
        try
        {
            var erfolg = await userService.ForgotPassword(resetEmail);

            if (erfolg)
            {
                Erfolgsmeldung = "Ein Link zum Zurücksetzen wurde an deine E-Mail gesendet.";
                showResetModal = false;
            }
            else
            {
                modalError = "Die E-Mail-Adresse konnte nicht gefunden werden.";
            }
        }
        catch (Exception)
        {
            modalError = "Es gab einen Fehler beim Verbinden mit dem Server.";
        }
        finally
        {
            isSending = false;
        }
    }
}