@page "/home"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model

<PageTitle>SchulFunk</PageTitle>

<section class="home-hero">
    <div class="home-hero-box sf-panel" id="aktuelle-nachrichten">
        <div class="home-news-header">
            <div class="home-news-icon">
                <img src="/lib/images/Icon-News.png" alt="Aktuelle Nachrichten Icon" />
            </div>

            <h2>Neuigkeiten aus deiner Schule</h2>
        </div>

        <div class="home-news-preview">
            @foreach (var news in AktuellsteNews)
            {
                <a href="/news/@news.Id" class="home-news-item home-news-link">
                    <span>@news.CreatedAt</span>
                    <h3>@news.Title</h3>
                    <p>@news.PreviewText</p>
                </a>
            }
        </div>
    </div>

    <div class="home-survey-preview sf-panel" id="umfragen">
        @if (AusgewerteteUmfragen.Any())
        {
            var aktuelleUmfrage = AusgewerteteUmfragen[AktuelleUmfrageIndex];
            var ersteFrage = aktuelleUmfrage.Questions.FirstOrDefault();

            <div class="home-survey-slide @SurveyAnimationClass" @key="AktuelleUmfrageIndex">
                <div class="home-preview-header">
                    <img src="/lib/images/Icon-Survey.png" alt="Umfrage Icon" />

                    <div>
                        <h3>@aktuelleUmfrage.Title</h3>
                        <p>@aktuelleUmfrage.CreatorName</p>
                    </div>
                </div>

                <p class="home-survey-description">
                    @aktuelleUmfrage.Description
                </p>

                @if (ersteFrage is not null)
                {
                    <h4>@ersteFrage.Question</h4>

                    @foreach (var answer in ersteFrage.Options)
                    {
                        var percentage = BerechneProzent(ersteFrage, answer);

                        <div class="home-vote-card @(percentage == HoechsterProzentwert(ersteFrage) ? "active" : "")">
                            <span>@answer.options</span>
                            <strong>@percentage%</strong>
                        </div>
                    }
                }

                <div class="home-survey-actions">
                    <button type="button"
                            class="home-survey-arrow"
                            @onclick="VorherigeUmfrage"
                            disabled="@(AusgewerteteUmfragen.Count <= 1)">
                        ↑
                    </button>

                    <button type="button"
                            class="home-survey-arrow"
                            @onclick="NaechsteUmfrage"
                            disabled="@(AusgewerteteUmfragen.Count <= 1)">
                        ↓
                    </button>
                </div>

                <a href="/survey/results/@aktuelleUmfrage.GroupId" class="sf-button sf-button-dark home-survey-link">
                    Ergebnisse ansehen
                </a>
            </div>
        }
        else
        {
            <div class="home-preview-header">
                <img src="/lib/images/Icon-Survey.png" alt="Umfrage Icon" />

                <div>
                    <h3>Keine ausgewerteten Umfragen</h3>
                    <p>Aktuell sind keine abgelaufenen Umfragen verfügbar.</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="home-useful-links">
    <article class="home-link-card sf-panel">
        <div class="home-link-icon">
            <img src="/lib/images/Icon-Calender.png" alt="Untis Icon" />
        </div>

        <h3>Untis</h3>
        <p>Öffne deinen Stundenplan, Vertretungsplan und aktuelle Planänderungen.</p>

        <a href="https://bkbeckum.webuntis.com/WebUntis/?school=bkbeckum#/basic/login"
           class="sf-button sf-button-dark"
           target="_blank"
           rel="noopener noreferrer">
            Zu Untis
        </a>
    </article>

    <article class="home-link-card sf-panel">
        <div class="home-link-icon">
            <img src="/lib/images/Icon-News.png" alt="Moodle Icon" />
        </div>

        <h3>Moodle</h3>
        <p>Greife auf Kurse, Aufgaben, Materialien und digitale Lerninhalte zu.</p>

        <a href="https://bkb-ecampus.de/login/index.php"
           class="sf-button sf-button-dark"
           target="_blank"
           rel="noopener noreferrer">
            Zu Moodle
        </a>
    </article>

    <article class="home-link-card sf-panel">
        <div class="home-link-icon">
            <img src="/lib/images/Icon-Messages.png" alt="Erasmus Icon" />
        </div>

        <h3>Erasmus</h3>
        <p>Informiere dich über Austauschprogramme, Projekte und internationale Angebote.</p>

        <a href="https://bkb-erasmus.de/"
           class="sf-button sf-button-dark"
           target="_blank"
           rel="noopener noreferrer">
            Zu Erasmus
        </a>
    </article>
</section>

<footer class="home-impressum sf-panel" id="impressum">
    <div>
        <h2>Impressum</h2>
        <p>
            SchulFunk ist ein Webprojekt zur Darstellung von Umfragen, Schulnachrichten
            und nützlichen Links für Schülerinnen und Schüler.
        </p>
    </div>

    <div class="home-impressum-grid">
        <div>
            <h3>Projekt</h3>
            <p>SchulFunk Webprojekt</p>
        </div>

        <div>
            <h3>Verantwortlich</h3>
            <p>Schülerprojekt / Projektgruppe SchulFunk</p>
        </div>

        <div>
            <h3>Kontakt</h3>
            <p>Bitte hier später eure Schul- oder Projektadresse eintragen.</p>
        </div>
    </div>
</footer>

@code {
    private int AktuelleUmfrageIndex = 0;
    private string SurveyAnimationClass = "slide-in";

    private IEnumerable<NewsItem> AktuellsteNews =>
        NewsData.NewsListe
            .OrderByDescending(news => news.Id)
            .Take(4);

    private List<SurveyModel> AusgewerteteUmfragen =>
        SurveyData.SurveyListe
            .Where(survey => survey.OnlineUntil < DateOnly.FromDateTime(DateTime.Today))
            .OrderByDescending(survey => survey.OnlineUntil)
            .Take(3)
            .ToList();

    private async Task NaechsteUmfrage()
    {
        if (AusgewerteteUmfragen.Count == 0)
        {
            return;
        }

        SurveyAnimationClass = "slide-out-up";
        await Task.Delay(140);

        AktuelleUmfrageIndex++;

        if (AktuelleUmfrageIndex >= AusgewerteteUmfragen.Count)
        {
            AktuelleUmfrageIndex = 0;
        }

        SurveyAnimationClass = "slide-in";
    }

    private async Task VorherigeUmfrage()
    {
        if (AusgewerteteUmfragen.Count == 0)
        {
            return;
        }

        SurveyAnimationClass = "slide-out-down";
        await Task.Delay(140);

        AktuelleUmfrageIndex--;

        if (AktuelleUmfrageIndex < 0)
        {
            AktuelleUmfrageIndex = AusgewerteteUmfragen.Count - 1;
        }

        SurveyAnimationClass = "slide-in";
    }

    private int BerechneProzent(QuestionModel question, AnswerModel answer)
    {
        var gesamtStimmen = question.Options.Sum(option => option.NumberOfSelectedAnswer);

        if (gesamtStimmen == 0)
        {
            return 0;
        }

        return (int)Math.Round((double)answer.NumberOfSelectedAnswer / gesamtStimmen * 100);
    }

    private int HoechsterProzentwert(QuestionModel question)
    {
        if (!question.Options.Any())
        {
            return 0;
        }

        return question.Options
            .Select(answer => BerechneProzent(question, answer))
            .Max();
    }
}
