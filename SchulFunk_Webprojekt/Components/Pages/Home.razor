@page "/home"
@rendermode InteractiveServer
@inject NewsService newsService
@inject SurveyService surveyService
@inject NewsStateService newsStateService
@inject SurveyStateService surveyStateService
@inject SignalRHub hub
@implements IDisposable

<PageTitle>SchulFunk</PageTitle>

<section class="home-overview">
    <section class="home-news-panel sf-panel" id="aktuelle-nachrichten">
        <div class="home-panel-head">
            <img src="/lib/images/Icon-News.png" alt="Aktuelle Nachrichten Icon" />

            <div>
                <span>Aktuelle Meldungen</span>
                <h2>Neuigkeiten</h2>
            </div>
        </div>

        <div class="home-news-list">
            @foreach (var news in NewsItems)
            {
                <a href="/news/@news.Id" class="home-news-item home-news-link">
                    <span>@news.CreatedAt</span>
                    <h3>@news.Title</h3>
                    <p>@news.PreviewText</p>
                </a>
            }
        </div>
    </section>

    <section class="home-survey-panel sf-panel" id="umfragen">
        @if (surveyModels.Any())
        {
            var aktuelleUmfrage = surveyModels[AktuelleUmfrageIndex];
            var ersteFrage = aktuelleUmfrage.Questions.FirstOrDefault();

            <div class="home-survey-slide @SurveyAnimationClass" @key="AktuelleUmfrageIndex">
                <div class="home-panel-head">
                    <img src="/lib/images/Icon-Survey.png" alt="Umfrage Icon" />

                    <div>
                        <span>Ausgewertete Umfrage</span>
                        <h2>@aktuelleUmfrage.Title</h2>
                    </div>
                </div>

                <p class="home-survey-description">
                    @aktuelleUmfrage.Description
                </p>

                @if (ersteFrage is not null)
                {
                    <div class="home-question-box">
                        <span>Frage</span>
                        <h3>@ersteFrage.Question</h3>
                    </div>

                    <div class="home-result-list">
                        @foreach (var answer in ersteFrage.AnswerModels)
                        {
                            var percentage = BerechneProzent(ersteFrage, answer);
                            var isTopAnswer = percentage == HoechsterProzentwert(ersteFrage);

                            <div class="home-result-card @(isTopAnswer ? "active" : "")">
                                <div class="home-result-line">
                                    <span>@answer.Answers</span>
                                    <strong>@percentage%</strong>
                                </div>

                                <div class="home-result-bar">
                                    <div style="width: @percentage%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="home-survey-bottom">
                    <div class="home-survey-actions">
                        <button type="button"
                                class="home-survey-arrow"
                                @onclick="VorherigeUmfrage"
                                disabled="@(surveyModels.Count <= 1)"
                                aria-label="Vorherige Umfrage">
                            ↑
                        </button>

                        <button type="button"
                                class="home-survey-arrow"
                                @onclick="NaechsteUmfrage"
                                disabled="@(surveyModels.Count <= 1)"
                                aria-label="Nächste Umfrage">
                            ↓
                        </button>
                    </div>

                    <a href="/survey/results/@aktuelleUmfrage.Id" class="sf-button home-survey-link">
                        Ergebnisse ansehen
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="home-empty-state">
                <img src="/lib/images/Icon-Survey.png" alt="Umfrage Icon" />
                <h2>Keine ausgewerteten Umfragen</h2>
                <p>Aktuell sind keine abgelaufenen Umfragen verfügbar.</p>
            </div>
        }
    </section>
</section>

<section class="home-useful-links">
    <a href="https://bkbeckum.webuntis.com/WebUntis/?school=bkbeckum#/basic/login"
           class="home-link-card"
           target="_blank"
           rel="noopener noreferrer">
        <div class="home-link-icon">
            <img src="/lib/images/Icon-Calender.png" alt="Untis Icon" />
        </div>

        <div>
            <h3>Untis</h3>
            <p>Stundenplan und Vertretungen</p>
        </div>
    </a>

    <a href="https://bkb-ecampus.de/login/index.php"
           class="home-link-card"
           target="_blank"
           rel="noopener noreferrer">
        <div class="home-link-icon">
            <img src="/lib/images/Icon-News.png" alt="Moodle Icon" />
        </div>

        <div>
            <h3>Moodle</h3>
            <p>Kurse, Aufgaben und Materialien</p>
        </div>
    </a>

    <a href="https://bkb-erasmus.de/"
           class="home-link-card"
           target="_blank"
           rel="noopener noreferrer">
        <div class="home-link-icon">
            <img src="/lib/images/Icon-Messages.png" alt="Erasmus Icon" />
        </div>

        <div>
            <h3>Erasmus</h3>
            <p>EU Austauschprogramm</p>
        </div>
    </a>
</section>

<footer class="home-impressum" id="impressum">
    <div class="home-footer-content">
        <h2>SchulFunk</h2>

        <p>
            SchulFunk ist ein Webprojekt zur Darstellung von Umfragen, Schulnachrichten
            und nützlichen Links für Schülerinnen und Schüler.
        </p>

        <nav class="home-footer-links">
            <a href="#impressum">Impressum</a>
            <a href="#">Datenschutz</a>
            <a href="#">Kontakt</a>
            <a href="#">Schulordnung</a>
        </nav>

        <small>© 2026 SchulFunk Webprojekt. Alle Rechte vorbehalten.</small>
    </div>
</footer>

@code {
    private int AktuelleUmfrageIndex = 0;
    private string SurveyAnimationClass = "slide-in";
    private IReadOnlyList<NewsItem> NewsItems => newsStateService.GetNewsItems();
    private IReadOnlyList<SurveyModel> surveyModels => surveyStateService.GetAllSurveys();

    protected async override Task OnInitializedAsync()
    {
        newsStateService.OnChange += UpdateUI;
        surveyStateService.OnChange += UpdateUI;

        await hub.Connect();
    }

    private void UpdateUI()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task NaechsteUmfrage()
    {
        if (surveyModels.Count == 0)
        {
            return;
        }

        SurveyAnimationClass = "slide-out-up";
        await Task.Delay(140);

        AktuelleUmfrageIndex++;

        if (AktuelleUmfrageIndex >= surveyModels.Count)
        {
            AktuelleUmfrageIndex = 0;
        }

        SurveyAnimationClass = "slide-in";
    }

    private async Task VorherigeUmfrage()
    {
        if (surveyModels.Count == 0)
        {
            return;
        }

        SurveyAnimationClass = "slide-out-down";
        await Task.Delay(140);

        AktuelleUmfrageIndex--;

        if (AktuelleUmfrageIndex < 0)
        {
            AktuelleUmfrageIndex = surveyModels.Count - 1;
        }

        SurveyAnimationClass = "slide-in";
    }

    private int BerechneProzent(QuestionModel question, AnswerModel answer)
    {
        var gesamtStimmen = question.AnswerModels.Sum(option => option.NumberOfSelectedAnswer);

        if (gesamtStimmen == 0)
        {
            return 0;
        }

        return (int)Math.Round((double)answer.NumberOfSelectedAnswer / gesamtStimmen * 100);
    }

    private int HoechsterProzentwert(QuestionModel question)
    {
        if (!question.AnswerModels.Any())
        {
            return 0;
        }

        return question.AnswerModels
            .Select(answer => BerechneProzent(question, answer))
            .Max();
    }
    public void Dispose()
    {
        newsStateService.OnChange -= StateHasChanged;
        surveyStateService.OnChange -= StateHasChanged;
    }
}