@page "/home"
@using SchulFunk_Webprojekt.Components.Pages.News
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>SchulFunk</PageTitle>

<div class="tab-container">
    <Search Placeholder="Nach News-Titeln oder Tags suchen..." @bind-Value="searchQuery" />

    <div class="page-content">
        <div class="sf-layout-wrapper">

            <NewsPage SearchQuery="@searchQuery"></NewsPage>
        </div>
    </div>
</div>

@code {
    private string searchQuery = "";

    protected override void OnParametersSet()
    {
        searchQuery = "";
    }
}