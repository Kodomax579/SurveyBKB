@page "/admin/news"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model

<PageTitle>Nachrichten verwalten</PageTitle>

@if (!CanAccessAdmin)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine Nachrichten verwalten.</p>
    </section>
}
else
{
    <section class="sf-page-header">
        <h1>Nachrichten verwalten</h1>
        <p>Bearbeite oder lösche Nachrichten entsprechend deiner Berechtigung.</p>
    </section>

    <section class="sf-filter-bar">
        <input type="text"
               class="sf-input sf-filter-search"
               placeholder="Nach Nachricht suchen..."
               @bind="Suchtext"
               @bind:event="oninput" />
    </section>

    @if (NewsInBearbeitung is not null)
    {
        <section class="sf-detail-box">
            <h3>Nachricht bearbeiten</h3>

            <div class="form-group">
                <label>Titel</label>
                <input class="form-control" @bind="EditTitle" @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label>Tag</label>
                <input class="form-control" @bind="EditTag" @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label>Kurzbeschreibung</label>
                <textarea class="form-control" rows="3" @bind="EditDescription" @bind:event="oninput"></textarea>
            </div>

            <div class="form-group">
                <label>Artikel</label>
                <textarea class="form-control" rows="6" @bind="EditArtikel" @bind:event="oninput"></textarea>
            </div>

            <div class="form-actions">
                <button type="button" class="sf-button sf-button-dark" @onclick="SaveNewsEdit">
                    Änderungen speichern
                </button>

                <button type="button" class="sf-button" @onclick="CancelNewsEdit">
                    Abbrechen
                </button>
            </div>
        </section>
    }

    <section class="admin-list">
        @foreach (var news in GefilterteNews)
        {
            <article class="admin-list-card sf-panel">
                <div class="admin-list-card-main">
                    <div>
                        <span class="sf-badge">@news.Tag</span>
                        <h3>@news.Title</h3>
                        <p>@news.PreviewText</p>

                        <div class="admin-meta">
                            <strong>Ersteller:</strong> @news.UserModel.Lastname @news.UserModel.Name ·
                            <strong>Datum:</strong> @news.ExpiredDate
                        </div>
                    </div>
                </div>

                <div class="admin-list-actions">
                    <a href="/news/@news.Id" class="sf-button">
                        Öffnen
                    </a>

                    @if (CanEditNews(news))
                    {
                        <button type="button"
                                class="sf-button sf-button-dark"
                                @onclick="() => StartNewsEdit(news)">
                            Bearbeiten
                        </button>
                    }

                    @if (CanDeleteNews(news))
                    {
                        <button type="button"
                                class="sf-button sf-danger-button"
                                @onclick="() => DeleteNews(news)">
                            Löschen
                        </button>
                    }
                </div>
            </article>
        }
    </section>
}

@code {
    private string Suchtext = "";

    private UserModel CurrentUser => TestLoginData.CurrentUser;

    private List<NewsItem> NewsListe = NewsData.NewsListe.ToList();

    private NewsItem? NewsInBearbeitung;

    private string EditTitle = "";
    private string EditTag = "";
    private string EditDescription = "";
    private string EditArtikel = "";

    private bool CanAccessAdmin =>
        PermissionRules.HasPermission(CurrentUser, Permission.ManageOwnNews) ||
        PermissionRules.HasPermission(CurrentUser, Permission.ManageAllNews);

    private bool CanManageOwnNews =>
        PermissionRules.HasPermission(CurrentUser, Permission.ManageOwnNews);

    private bool CanManageAllNews =>
        PermissionRules.HasPermission(CurrentUser, Permission.ManageAllNews);

    private IEnumerable<NewsItem> GefilterteNews =>
        NewsListe
            .Where(news => CanSeeNews(news))
            .Where(news =>
                string.IsNullOrWhiteSpace(Suchtext) ||
                news.Title.Contains(Suchtext, StringComparison.OrdinalIgnoreCase));

    private bool CanSeeNews(NewsItem news)
    {
        if (CanManageAllNews)
        {
            return true;
        }

        if (CanManageOwnNews)
        {
            return news.UserModel.Email == CurrentUser.Email;
        }

        return false;
    }

    private bool CanEditNews(NewsItem news)
    {
        return CanSeeNews(news);
    }

    private bool CanDeleteNews(NewsItem news)
    {
        return CanSeeNews(news);
    }

    private void StartNewsEdit(NewsItem news)
    {
        if (!CanEditNews(news))
        {
            return;
        }

        NewsInBearbeitung = news;
        EditTitle = news.Title;
        EditTag = news.Tag;
        EditDescription = news.PreviewText;
        EditArtikel = news.MainText;
    }

    private void SaveNewsEdit()
    {
        if (NewsInBearbeitung is null || !CanEditNews(NewsInBearbeitung))
        {
            return;
        }

        NewsInBearbeitung.Title = EditTitle;
        NewsInBearbeitung.Tag = EditTag;
        NewsInBearbeitung.PreviewText = EditDescription;
        NewsInBearbeitung.MainText = EditArtikel;

        CancelNewsEdit();
    }

    private void CancelNewsEdit()
    {
        NewsInBearbeitung = null;
        EditTitle = "";
        EditTag = "";
        EditDescription = "";
        EditArtikel = "";
    }

    private void DeleteNews(NewsItem news)
    {
        if (!CanDeleteNews(news))
        {
            return;
        }

        NewsListe.Remove(news);

        if (NewsInBearbeitung == news)
        {
            CancelNewsEdit();
        }
    }
}