@page "/admin"
@using SchulFunk_Webprojekt.Model

<PageTitle>Admin Panel</PageTitle>

<section class="admin-header sf-panel">
    <div class="admin-title">
        <img src="/lib/images/Icon-User.png" alt="Admin Icon" />

        <div>
            <h2>Admin Panel</h2>
            <p>Verwalte Umfragen, Nachrichten und Benutzer entsprechend deiner Berechtigungen.</p>
        </div>
    </div>
</section>

@if (!CanAccessAdmin)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du hast keine Berechtigung für das Admin Panel.</p>
    </section>
}
else
{
    <section class="admin-dashboard-grid">
        @if (CanCreateSurveys)
        {
            <a href="/survey/create" class="admin-dashboard-card sf-panel">
                <img src="/lib/images/Icon-Survey.png" alt="" />
                <h3>Umfrage erstellen</h3>
                <p>Erstelle neue Umfragen für deine Klasse oder Zielgruppe.</p>
            </a>

            <a href="/admin/surveys" class="admin-dashboard-card sf-panel">
                <img src="/lib/images/Icon-Survey.png" alt="" />
                <h3>Umfragen verwalten</h3>
                <p>Verwalte und lösche berechtigte Umfragen.</p>
            </a>
        }

        @if (CanCreateNews)
        {
            <a href="/news/create" class="admin-dashboard-card sf-panel">
                <img src="/lib/images/Icon-News.png" alt="" />
                <h3>Nachricht erstellen</h3>
                <p>Erstelle neue Schulnachrichten für SchulFunk.</p>
            </a>
        }

        @if (CanManageNews)
        {
            <a href="/admin/news" class="admin-dashboard-card sf-panel">
                <img src="/lib/images/Icon-News.png" alt="" />
                <h3>Nachrichten verwalten</h3>
                <p>Bearbeite oder lösche Nachrichten, die du erstellt hast.</p>
            </a>
        }

        @if (CanEditUsers)
        {
            <a href="/admin/users" class="admin-dashboard-card sf-panel">
                <img src="/lib/images/Icon-User.png" alt="" />
                <h3>Benutzer bearbeiten</h3>
                <p>Ändere Klassen und Gruppen von Schülerinnen und Schülern.</p>
            </a>
        }
    </section>
}

@code {
    private UserModel CurrentUser = new()
    {
        Name = "Max",
        Lastname = "Mustermann",
        Email = "max.mustermann@schule.de",
        Class = new ClassModel { ClassName = "10A" },
        Group = Groups.Teacher
    };

    private bool CanAccessAdmin =>
        CurrentUser.Group is Groups.Teacher
            or Groups.ClassRepresentatives
            or Groups.StudentRepresentatives
            or Groups.Admin;

    private bool CanCreateSurveys =>
        CurrentUser.Group is Groups.Teacher
            or Groups.ClassRepresentatives
            or Groups.StudentRepresentatives
            or Groups.Admin;

    private bool CanCreateNews =>
        CurrentUser.Group is Groups.Teacher
            or Groups.StudentRepresentatives
            or Groups.Admin;

    private bool CanEditUsers =>
        CurrentUser.Group is Groups.Teacher
            or Groups.Admin;

    private bool CanManageNews =>
        CanCreateNews || NewsData.NewsListe.Any(news => IsCreatedByCurrentUser(news.CreatedUserID));

    private bool IsCreatedByCurrentUser(int createdUserId)
    {
        return GetCreatorEmail(createdUserId) == CurrentUser.Email;
    }

    private static string GetCreatorEmail(int createdUserId)
    {
        return createdUserId switch
        {
            1 => "max.mustermann@schule.de",
            2 => "schuelervertretung@schule.de",
            3 => "klassensprecher@schule.de",
            _ => ""
        };
    }
}