@page "/admin/users"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model
@using Microsoft.AspNetCore.Components.Forms
@inject UserStateService userStateService
@inject UserService userService

<PageTitle>Benutzer bearbeiten</PageTitle>

@if (!CanEditUsers)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine Benutzer bearbeiten.</p>
    </section>
}
else
{
    <section class="sf-page-header">
        <h1>Benutzer bearbeiten</h1>
        <p>Ändere Klassen und Gruppen entsprechend deiner Berechtigung.</p>
    </section>

    <section class="sf-filter-bar admin-user-toolbar">
        <input type="text"
               class="sf-input sf-filter-search"
               placeholder="Nach Benutzer suchen..."
               @bind="Suchtext"
               @bind:event="oninput" />

        <div class="admin-filter-dropdown sf-filter-action">
            <button type="button"
                    class="sf-button sf-button-dark admin-filter-button"
                    @onclick="ToggleFilterPanel">
                Filter
            </button>

            @if (FilterPanelVisible)
            {
                <div class="admin-filter-menu">
                    <div class="admin-filter-menu-head">
                        <strong>Benutzer filtern</strong>
                        <span>@GefilterteUsers.Count() Treffer</span>
                    </div>

                    <div class="form-group">
                        <label>Klasse</label>

                        <select class="form-control" @bind="SelectedClass">
                            <option value="">Alle Klassen</option>

                            @foreach (var klasse in AvailableClasses)
                            {
                                <option value="@klasse.Classname">@klasse.Classname</option>
                            }

                            @if (CurrentUser.Group == Groups.Admin)
                            {
                                <option value="Lehrer">Lehrer</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Gruppe</label>

                        <select class="form-control" @bind="SelectedGroup">
                            <option value="">Alle Gruppen</option>

                            @foreach (var group in AvailableGroupFilters)
                            {
                                <option value="@group.ToString()">@PermissionRules.GetGroupLabel(group)</option>
                            }
                        </select>
                    </div>

                    <button type="button"
                            class="sf-button admin-reset-filter-button"
                            @onclick="ResetFilters">
                        Filter zurücksetzen
                    </button>
                </div>
            }
        </div>
    </section>

    <div class="admin-user-result-info">
        <span class="sf-badge">@GefilterteUsers.Count() Benutzer gefunden</span>
    </div>

    <section class="sf-auto-grid">
        @foreach (var user in GefilterteUsers)
        {
            <article class="sf-flat-card">
                <div class="sf-flat-card-body">
                    <div class="sf-card-meta">
                        <span>@PermissionRules.GetGroupLabel(user.Group)</span>
                        <span>@user.Class.Classname</span>
                    </div>

                    <h3>@GetFullName(user)</h3>
                    <p>@user.Email</p>

                    <div class="form-group">
                        <label>Klasse</label>

                        @if (user.Group == Groups.Teacher)
                        {
                            <div class="readonly-info-box">
                                <strong>Lehrer</strong>
                            </div>
                        }
                        else
                        {
                            <select class="form-control" @bind="user.Class.Classname">
                                @foreach (var klasse in AvailableClasses)
                                {
                                    <option value="@klasse.Classname">@klasse.Classname</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="form-group">
                        <label>Gruppe</label>

                        <select class="form-control" @bind="user.Group">
                            @foreach (var group in GetEditableGroupsForUser(user))
                            {
                                <option value="@group">@PermissionRules.GetGroupLabel(group)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Profilbild</label>
                        <InputFile OnChange="async e => await OnFileSelected(e, user)" />
                        @if (!string.IsNullOrWhiteSpace(user.ImageLink))
                        {
                            <div style="margin-top:8px;">
                                <img src="@user.ImageLink" alt="Avatar" style="max-width:120px; max-height:120px;" />
                            </div>
                        }
                    </div>

                    <div class="form-actions">
                        <button type="button" class="sf-button sf-button-dark" @onclick="() => SaveUser(user)">
                            Änderungen speichern
                        </button>

                        @if (CanDeleteUser(user))
                        {
                            <button type="button"
                                    class="sf-button sf-danger-button"
                                    @onclick="() => DeleteUser(user)">
                                Benutzer löschen
                            </button>
                        }
                    </div>
                </div>
            </article>
        }
    </section>
}

@code {
    private string Suchtext = "";
    private string SelectedClass = "";
    private string SelectedGroup = "";
    private bool FilterPanelVisible = false;
    private UserModel? CurrentUser => userStateService.GetUser();
    private List<UserModel>? AllUser = new();
    private List<ClassModel>? AvailableClasses = new();

    protected async override Task OnInitializedAsync()
    {
        AllUser = await userService.GetAllUsers();
        AvailableClasses = await userService.GetAllClasses();
    }


    private bool CanEditUsers =>
        PermissionRules.HasPermission(CurrentUser, Permission.EditStudentUsers) ||
        PermissionRules.HasPermission(CurrentUser, Permission.EditTeacherUsers);

    private bool CanDeleteUsers =>
        PermissionRules.HasPermission(CurrentUser, Permission.DeleteUsers);


    private List<Groups> AvailableGroupFilters =>
        CurrentUser.Group == Groups.Admin
            ? new List<Groups>
            {
                Groups.Student,
                Groups.ClassRepresentatives,
                Groups.StudentRepresentatives,
                Groups.Teacher
            }
            : new List<Groups>
            {
                Groups.Student,
                Groups.ClassRepresentatives,
                Groups.StudentRepresentatives
            };


    private IEnumerable<UserModel> GefilterteUsers =>
        AllUser
            .Where(user => CanEditUser(user))
            .Where(user => MatchesSearch(user))
            .Where(user => MatchesClassFilter(user))
            .Where(user => MatchesGroupFilter(user));

    private bool MatchesSearch(UserModel user)
    {
        if (string.IsNullOrWhiteSpace(Suchtext))
        {
            return true;
        }

        return GetFullName(user).Contains(Suchtext, StringComparison.OrdinalIgnoreCase) ||
               user.Email.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) ||
               user.Class.Classname.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) ||
               PermissionRules.GetGroupLabel(user.Group).Contains(Suchtext, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesClassFilter(UserModel user)
    {
        if (string.IsNullOrWhiteSpace(SelectedClass))
        {
            return true;
        }

        return user.Class.Classname == SelectedClass;
    }

    private bool MatchesGroupFilter(UserModel user)
    {
        if (string.IsNullOrWhiteSpace(SelectedGroup))
        {
            return true;
        }

        return user.Group.ToString() == SelectedGroup;
    }

    private bool CanEditUser(UserModel user)
    {
        if (user.Group == Groups.Admin)
        {
            return false;
        }

        if (user.Group == Groups.Teacher)
        {
            return PermissionRules.HasPermission(CurrentUser, Permission.EditTeacherUsers);
        }

        return PermissionRules.HasPermission(CurrentUser, Permission.EditStudentUsers);
    }

    private List<Groups> GetEditableGroupsForUser(UserModel user)
    {
        if (CurrentUser.Group == Groups.Admin)
        {
            return new List<Groups>
            {
                Groups.Student,
                Groups.ClassRepresentatives,
                Groups.StudentRepresentatives,
                Groups.Teacher
            };
        }

        return new List<Groups>
        {
            Groups.Student,
            Groups.ClassRepresentatives,
            Groups.StudentRepresentatives
        };
    }

    private bool CanDeleteUser(UserModel user)
    {
        return CanDeleteUsers && user.Group != Groups.Admin;
    }

    private void DeleteUser(UserModel user)
    {
        if (!CanDeleteUser(user))
        {
            return;
        }

        AllUser.Remove(user);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e, UserModel user)
    {
        var file = e.File;
        if (file == null) return;

        var link = await userService.UploadProfileImage(user.Id, file);
        if (!string.IsNullOrWhiteSpace(link))
        {
            user.ImageLink = link;
            StateHasChanged();
        }
    }

    private async Task SaveUser(UserModel user)
    {
        await userService.UpdateUser(user.Id, user);
    }

    private void ToggleFilterPanel()
    {
        FilterPanelVisible = !FilterPanelVisible;
    }

    private void ResetFilters()
    {
        SelectedClass = "";
        SelectedGroup = "";
    }

    private static string GetFullName(UserModel user)
    {
        return $"{user.Lastname} {user.Firstname}".Trim();
    }
}