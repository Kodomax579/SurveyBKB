@page "/admin/surveys"
@rendermode InteractiveServer
@using SchulFunk_Webprojekt.Model

<PageTitle>Umfragen verwalten</PageTitle>

<section class="admin-header sf-panel">
    <div class="admin-title">
        <img src="/lib/images/Icon-Survey.png" alt="Survey Icon" />

        <div>
            <h2>Umfragen verwalten</h2>
            <p>Hier kannst du Umfragen einsehen und berechtigte Umfragen löschen.</p>
        </div>
    </div>

    @if (CanCreateSurveys)
    {
        <a href="/survey/create" class="sf-button sf-button-dark">
            Umfrage erstellen
        </a>
    }
</section>

@if (!CanAccessAdmin)
{
    <section class="admin-empty sf-panel">
        <h3>Kein Zugriff</h3>
        <p>Du darfst keine Umfragen verwalten.</p>
    </section>
}
else
{
    <section class="admin-toolbar sf-panel">
        <input type="text"
               class="admin-search-input"
               placeholder="Nach Umfrage suchen..."
               @bind="Suchtext"
               @bind:event="oninput" />
    </section>

    <section class="admin-list">
        @foreach (var survey in GefilterteUmfragen)
        {
            <article class="admin-list-card sf-panel">
                <div class="admin-list-card-main">
                    <img src="/lib/images/Icon-Survey.png" alt="" />

                    <div>
                        <span>Umfrage</span>
                        <h3>@survey.Title</h3>
                        <p>@survey.Description</p>

                        <div class="admin-meta">
                            <strong>Ersteller:</strong> @survey.CreatorName ·
                            <strong>Fragen:</strong> @survey.Questions.Count ·
                            <strong>Läuft bis:</strong> @survey.OnlineUntil.ToString("dd.MM.yyyy")
                        </div>
                    </div>
                </div>

                <div class="admin-list-actions">
                    <a href="/survey/@survey.GroupId" class="sf-button">
                        Öffnen
                    </a>

                    @if (CanDeleteSurvey(survey))
                    {
                        <button type="button"
                                class="sf-button sf-danger-button"
                                @onclick="() => DeleteSurvey(survey)">
                            Löschen
                        </button>
                    }
                </div>
            </article>
        }
    </section>
}

@code {
    private string Suchtext = "";

    private UserModel CurrentUser = new()
    {
        Name = "Max",
        Lastname = "Mustermann",
        Email = "max.mustermann@schule.de",
        Class = new ClassModel { ClassName = "10A" },
        Group = Groups.Teacher
    };

    private List<SurveyModel> Surveys = SurveyData.SurveyListe.ToList();

    private bool CanAccessAdmin =>
        CurrentUser.Group is Groups.Teacher
            or Groups.ClassRepresentatives
            or Groups.StudentRepresentatives
            or Groups.Admin;

    private bool CanCreateSurveys =>
        CurrentUser.Group is Groups.Teacher
            or Groups.ClassRepresentatives
            or Groups.StudentRepresentatives
            or Groups.Admin;

    private IEnumerable<SurveyModel> GefilterteUmfragen =>
        Surveys
            .Where(survey => CanSeeSurveyInAdmin(survey))
            .Where(survey =>
                string.IsNullOrWhiteSpace(Suchtext) ||
                survey.Title.Contains(Suchtext, StringComparison.OrdinalIgnoreCase));

    private bool CanSeeSurveyInAdmin(SurveyModel survey)
    {
        if (CurrentUser.Group is Groups.Teacher or Groups.Admin)
        {
            return true;
        }

        return IsCreatedByCurrentUser(survey.CreatedUserID);
    }

    private bool CanDeleteSurvey(SurveyModel survey)
    {
        if (CurrentUser.Group is Groups.Teacher or Groups.Admin)
        {
            return true;
        }

        return IsCreatedByCurrentUser(survey.CreatedUserID);
    }

    private bool IsCreatedByCurrentUser(int createdUserId)
    {
        return GetCreatorEmail(createdUserId) == CurrentUser.Email;
    }

    private static string GetCreatorEmail(int createdUserId)
    {
        return createdUserId switch
        {
            1 => "max.mustermann@schule.de",
            2 => "schuelervertretung@schule.de",
            3 => "klassensprecher@schule.de",
            _ => ""
        };
    }

    private void DeleteSurvey(SurveyModel survey)
    {
        Surveys.Remove(survey);
    }
}