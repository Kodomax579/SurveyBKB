@using Microsoft.JSInterop
@using SchulFunk_Webprojekt.Model
@inject NavigationManager NavManager
@inject UserStateService userStateService
@inject IJSRuntime JS
@implements IDisposable

<header class="sf-header">
    <NavLink class="sf-brand" href="/home" Match="NavLinkMatch.All">
        <img class="sf-logo" src="/lib/images/SchulFunk-Logo.png" alt="SchulFunk Logo" />

        <div class="sf-brand-text">
            <h1>Schul<span>Funk</span></h1>
        </div>
    </NavLink>

    <nav class="sf-navbar">
        <NavLink class="sf-nav-button" href="/home" Match="NavLinkMatch.All">
            Startseite
        </NavLink>

        <NavLink class="sf-nav-button" href="/survey">
            Umfragen
        </NavLink>

        <NavLink class="sf-nav-button" href="/news">
            Nachrichten
        </NavLink>

        @if (CanOpenAdminPanel)
        {
            <NavLink class="sf-nav-button sf-admin-button" href="/admin">
                Admin Panel
            </NavLink>
        }

        <div class="sf-settings-dropdown">
            <button type="button"
                    class="sf-settings-button"
                    @onclick="ToggleSettingsMenu"
                    aria-label="Profil öffnen">
                <span>Profil</span>
            </button>

            @if (SettingsMenuOpen)
            {
                <div class="sf-settings-menu">
                    <div class="sf-settings-user">
                        <strong>@CurrentUser.Lastname @CurrentUser.Firstname</strong>
                        <span>@PermissionRules.GetGroupLabel(CurrentUser.Group)</span>
                    </div>

                    <NavLink class="sf-settings-menu-item" href="/profile" @onclick="CloseSettingsMenu">
                        Mein Profil
                    </NavLink>

                    <button type="button"
                            class="sf-settings-menu-item sf-theme-toggle"
                            @onclick="ToggleTheme">
                        <span class="sf-theme-toggle-icon">
                            @(IsDarkMode ? "☀" : "🌙")
                        </span>

                        <span>
                            @(IsDarkMode ? "White Mode aktivieren" : "Dark Mode aktivieren")
                        </span>
                    </button>

                    <button type="button"
                            class="sf-settings-menu-item sf-settings-logout"
                            @onclick="Logout">
                        Abmelden
                    </button>
                </div>
            }
        </div>
    </nav>
</header>

@code {
    private bool SettingsMenuOpen = false;
    private bool IsDarkMode = true;

    private UserModel CurrentUser => userStateService.GetUser();

    private bool CanOpenAdminPanel =>
        PermissionRules.HasPermission(CurrentUser, Permission.OpenAdminPanel);

    protected override void OnInitialized()
    {
        userStateService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("schulFunkTheme.get");

            IsDarkMode = theme != "light";

            await JS.InvokeVoidAsync("schulFunkTheme.apply", IsDarkMode ? "dark" : "light");

            StateHasChanged();
        }
    }

    private void ToggleSettingsMenu()
    {
        SettingsMenuOpen = !SettingsMenuOpen;
    }

    private void CloseSettingsMenu()
    {
        SettingsMenuOpen = false;
    }

    private async Task ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;

        var theme = IsDarkMode ? "dark" : "light";

        await JS.InvokeVoidAsync("schulFunkTheme.set", theme);
    }

    private void Logout()
    {
        SettingsMenuOpen = false;
        NavManager.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        userStateService.OnChange -= HandleStateChanged;
    }
}