@using SchulFunk_Webprojekt.Model
@inject IJSRuntime JS

<header class="sf-header">
    <NavLink href="/home" class="sf-brand">
        <img src="/lib/images/SchulFunk-Logo.png" alt="SchulFunk Logo" class="sf-logo" />

        <div class="sf-brand-text">
            <h1>
                Schul<span>Funk</span>
            </h1>
        </div>
    </NavLink>

    <nav class="sf-navbar">
        @if (CanSeeAdminPanel)
        {
            <NavLink href="/admin" class="sf-nav-button sf-admin-button">
                Admin Panel
            </NavLink>
        }

        <NavLink href="/survey" class="sf-nav-button sf-nav-button-dark">
            Umfragen ansehen
        </NavLink>

        <NavLink href="/news" class="sf-nav-button">
            Aktuelle Nachrichten
        </NavLink>

        <div class="sf-settings-dropdown">
            <button type="button"
                    class="sf-nav-button sf-settings-button"
                    @onclick="ToggleSettingsMenu">
                <img src="/lib/images/Icon-User.png" alt="" />
                Einstellungen
            </button>

            @if (SettingsMenuVisible)
            {
                <div class="sf-settings-menu @(SettingsMenuClosing ? "sf-settings-menu-closing" : "")">
                    <div class="sf-settings-user">
                        <strong>@UserName</strong>
                        <span>@UserClass</span>
                        <span>@UserRole</span>
                    </div>

                    <a href="/profile"
                           class="sf-settings-menu-item"
                           @onclick="CloseSettingsMenu">
                        Profil ansehen
                    </a>
                    <button type="button"
                            class="sf-settings-menu-item sf-theme-toggle"
                            @onclick="ToggleTheme">
                        <span class="sf-theme-toggle-icon">
                            @(IsDarkMode ? "☀️" : "🌙")
                        </span>

                        <span>
                            @(IsDarkMode ? "White Mode aktivieren" : "Dark Mode aktivieren")
                        </span>
                    </button>
                    <button type="button"
                            class="sf-settings-menu-item sf-settings-logout"
                            @onclick="Logout">
                        Ausloggen
                    </button>
                </div>
            }
        </div>
    </nav>
</header>

@code {
    private bool SettingsMenuVisible = false;
    private bool SettingsMenuClosing = false;

    // Testdaten fürs Frontend.
    // Später kommt dieser User aus eurem Login/Auth-System.
    private UserModel CurrentUser => TestLoginData.CurrentUser;

    private bool CanSeeAdminPanel =>
    PermissionRules.HasPermission(CurrentUser, Permission.OpenAdminPanel);

    private string UserName =>
        $"{CurrentUser.Name} {CurrentUser.Lastname}".Trim();

    private string UserClass =>
        CurrentUser.Class.ClassName;

    private string UserRole =>
        GetGroupLabel(CurrentUser.Group);

    private async Task ToggleSettingsMenu()
    {
        if (SettingsMenuVisible)
        {
            await CloseSettingsMenu();
        }
        else
        {
            SettingsMenuClosing = false;
            SettingsMenuVisible = true;
        }
    }

    private async Task CloseSettingsMenu()
    {
        if (!SettingsMenuVisible)
        {
            return;
        }

        SettingsMenuClosing = true;
        await Task.Delay(180);

        SettingsMenuVisible = false;
        SettingsMenuClosing = false;
    }

    private async Task Logout()
    {
        await CloseSettingsMenu();

        // Später kommt hier eure echte Logout-Logik hin.
    }

    private static string GetGroupLabel(Groups group)
    {
        return group switch
        {
            Groups.Teacher => "Lehrer",
            Groups.ClassRepresentatives => "Klassensprecher",
            Groups.StudentRepresentatives => "Schülersprecher",
            Groups.Admin => "Admin",
            _ => "Schüler"
        };
    }

    private bool IsDarkMode = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("schulFunkTheme.get");

            IsDarkMode = theme != "light";

            await JS.InvokeVoidAsync("schulFunkTheme.apply", IsDarkMode ? "dark" : "light");

            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;

        var theme = IsDarkMode ? "dark" : "light";

        await JS.InvokeVoidAsync("schulFunkTheme.set", theme);
    }
}