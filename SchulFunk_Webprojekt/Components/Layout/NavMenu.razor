<header class="sf-header">
    <NavLink href="/home" class="sf-brand">
        <img src="/lib/images/SchulFunk-Logo.png" alt="SchulFunk Logo" class="sf-logo" />

        <div class="sf-brand-text">
            <h1>
                Schul<span>Funk</span>
            </h1>
        </div>
    </NavLink>

    <nav class="sf-navbar">
        @if (IstLehrer)
        {
            <NavLink href="/admin" class="sf-nav-button sf-admin-button">
                Admin Panel
            </NavLink>
        }

        <NavLink href="/survey" class="sf-nav-button sf-nav-button-dark">
            Umfragen ansehen
        </NavLink>

        <NavLink href="/news" class="sf-nav-button">
            Aktuelle Nachrichten
        </NavLink>

        <div class="sf-settings-dropdown">
            <button type="button"
                    class="sf-nav-button sf-settings-button"
                    @onclick="ToggleSettingsMenu">
                <img src="/lib/images/Icon-User.png" alt="" />
                Einstellungen
            </button>

            @if (SettingsMenuVisible)
            {
                <div class="sf-settings-menu @(SettingsMenuClosing ? "sf-settings-menu-closing" : "")">
                    <div class="sf-settings-user">
                        <strong>@UserName</strong>
                        <span>@UserClass</span>
                        <span>@UserRole</span>
                    </div>

                    <a href="/profile"
                           class="sf-settings-menu-item"
                           @onclick="CloseSettingsMenu">
                        Profil ansehen
                    </a>

                    <button type="button"
                            class="sf-settings-menu-item sf-settings-logout"
                            @onclick="Logout">
                        Ausloggen
                    </button>
                </div>
            }
        </div>
    </nav>
</header>

@code {
    private bool IstLehrer = true;

    private bool SettingsMenuVisible = false;
    private bool SettingsMenuClosing = false;

    // Testdaten fürs Frontend.
    // Später kommen diese Werte aus dem Login/Auth-System.
    private string UserName = "Max Mustermann";
    private string UserClass = "10A";
    private string UserRole = "Klassensprecher";

    private async Task ToggleSettingsMenu()
    {
        if (SettingsMenuVisible)
        {
            await CloseSettingsMenu();
        }
        else
        {
            SettingsMenuClosing = false;
            SettingsMenuVisible = true;
        }
    }

    private async Task CloseSettingsMenu()
    {
        if (!SettingsMenuVisible)
        {
            return;
        }

        SettingsMenuClosing = true;
        await Task.Delay(180);

        SettingsMenuVisible = false;
        SettingsMenuClosing = false;
    }

    private async Task Logout()
    {
        await CloseSettingsMenu();

        // Später kommt hier die echte Logout-Logik hin.
    }
}